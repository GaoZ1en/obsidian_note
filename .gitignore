# Ignore Obsidian configuration files
/.obsidian/

# Ignore attachments and media files
/Attachments/
/Literature Notes/articles/
/**/*.jpg
/**/*.jpeg
/**/*.JPG
/**/*.JPEG

# Ignore json data files
/**/*.json
!/tools/obsidian-md-formatter/package.json
!/tools/obsidian-md-formatter/package-lock.json
!/tools/obsidian-md-formatter/manifest.json
!/tools/obsidian-md-formatter/tsconfig.json
!/tools/obsidian-md-formatter/versions.json
!/tools/miniterm/package.json
!/tools/miniterm/package-lock.json
!/tools/miniterm/manifest.json
!/tools/miniterm/tsconfig.json
!/tools/mcp-servers/*/package.json
!/tools/mcp-servers/*/package-lock.json
!/tools/mcp-servers/*/tsconfig.json
/tools/mcp-servers/*/node_modules/
/tools/mcp-servers/*/build/
/.keep-the-rhythm/
/.vscode/
/.github/
/.claude/

# Ignore simulation codes
/**/__pycache__/
/**/*.npz
/**/requirements.txt
/**/*.png

# Ignore local solver projects
tools/eternal-solitaire-solver/

# Ignore third-party WeChat decrypt tool (cloned repo with own .git)
tools/wechat-decrypt/

# Ignore compressed files
/**/*.zip

# Ignore RTK.md
/.RTK.md
