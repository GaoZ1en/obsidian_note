
checks={};
put[label_,expr_]:=AppendTo[checks,<|"label"->label,"passed"->TrueQ[expr]|>];
hr[f_,v_]:=Module[{y},Integrate[f/.v->y,{y,0,v}]-v Integrate[f,{v,0,1}]];
ha[f_,v_]:=Module[{y},Integrate[f/.v->y,{y,0,v}]-Integrate[(1-v)f,{v,0,1}]];
poly=Sum[a[j]t^j,{j,0,6}];
put["relative_primitive_has_two_zero_caps",Simplify[(hr[poly,t]/.t->0)==0&&(hr[poly,t]/.t->1)==0]];
put["relative_derivative_retains_mean",Simplify[D[hr[poly,t],t]==poly-Integrate[poly,{t,0,1}]]];
put["relative_primitive_of_derivative",Simplify[hr[D[poly,t],t]==poly-(poly/.t->0)-t((poly/.t->1)-(poly/.t->0))]];
put["absolute_primitive_has_zero_mean_and_correct_derivative",Simplify[Integrate[ha[poly,t],{t,0,1}]==0&&D[ha[poly,t],t]==poly]];
put["absolute_primitive_recovers_field_minus_mean",Simplify[ha[D[poly,t],t]==poly-Integrate[poly,{t,0,1}]]];
bb=Sum[b[j]t^j,{j,0,4}]; zp=Sum[z[j]t^j,{j,0,3}]; xp=zp-D[bb,t];
put["antifield_inverse_recovers_b",Simplify[Integrate[bb,{t,0,1}]+ha[zp-xp,t]==bb]];
dxi=t(1-t)(h0+h1 t+h2 t^2); dz=t(1-t)(v0+v1 t);
oldtheta=Integrate[zp(dxi+dz)+bb(dsig+D[dxi,t]),{t,0,1}];
newtheta=Integrate[zp dz+(zp-D[bb,t])dxi,{t,0,1}]+Integrate[bb,{t,0,1}]dsig;
put["vertical_cotangent_identity",Simplify[oldtheta==newtheta]];
dlin=(1-t)di+t df;
put["full_cotangent_retains_horizontal_piece",Simplify[Integrate[zp(dlin+dxi+dz)+bb(dsig+D[dxi,t]),{t,0,1}]-newtheta==Integrate[zp dlin,{t,0,1}]]];
put["unrestricted_cap_defect_nonzero",Integrate[D[t,t],{t,0,1}]==1];
xlin=(1-t)xi+t xf; xx=t(1-t)(a0+a1 t); zz=t(1-t)(z0+z1 t+z2 t^2);
xxold=xlin+xx+zz; uu=sigma+D[xx,t];
pp=Sum[p[j]t^j,{j,0,4}];
put["physical_source_action_separates_relative_pair",Simplify[pp(D[xxold,t]-uu)==pp(D[zz,t]+xf-xi-sigma)]];
rr=s+s^2; xs=s(1-s)(x0+x1 s); ps=k D[rr,s];
put["proper_symmetric_cap_generator",Simplify[k/2 Integrate[D[xs,s]rr,{s,0,1}]==-1/2 Integrate[xs ps,{s,0,1}]]];
ee[n_,v_]:=Sqrt[2n+1]LegendreP[n,2v-1];
vv[n_,v_]:=Integrate[ee[n,y],{y,0,v}];
ww[n_,v_]:=-D[ee[n,v],v];
gram=Table[Integrate[vv[n,t]ww[m,t],{t,0,1}],{n,1,4},{m,1,4}];
kin=Table[Integrate[ee[m,t]D[vv[n,t],t],{t,0,1}],{n,1,4},{m,1,4}];
put["relative_smooth_bases_dual",Simplify[gram==IdentityMatrix[4]]];
put["axial_kinetic_pairing_is_canonical",Simplify[kin==IdentityMatrix[4]]];
put["relative_source_mean_is_not_discarded",hr[1,t]==0&&Integrate[1,{t,0,1}]==1];
tr[f_,shift_]:=f/.x->x-shift;
put["translation_two_and_three_composition",And@@Table[Expand[tr[tr[x^n,s1],s2]-tr[x^n,s1+s2]]==0&&Expand[tr[tr[tr[x^n,s1],s2],s3]-tr[x^n,s1+s2+s3]]==0,{n,0,6}]];
fourier=Integrate[Exp[-eps u^2/(2 hb^2)-I u aval/hb]/(2 Pi hb),{u,-Infinity,Infinity},Assumptions->eps>0&&hb>0&&Element[aval,Reals]];
put["fixed_response_source_kernel",FullSimplify[fourier==Exp[-aval^2/(2 eps)]/Sqrt[2 Pi eps],Assumptions->eps>0&&hb>0&&Element[aval,Reals]]];
mass=Integrate[Exp[-aval^2/(2 eps)]/Sqrt[2 Pi eps],{aval,-Infinity,Infinity},Assumptions->eps>0];
probe=Integrate[Exp[-aval^2/(2 eps)-(aval-a0)^2]/Sqrt[2 Pi eps],{aval,-Infinity,Infinity},Assumptions->eps>0&&Element[a0,Reals]];
put["integrating_fixed_response_wrongly_loses_delta",mass==1&&FullSimplify[Limit[probe,eps->0,Direction->"FromAbove"]==Exp[-a0^2],Assumptions->Element[a0,Reals]]];
<|"allPassed"->And@@Lookup[checks,"passed"],"count"->Length[checks],"checks"->checks|>
