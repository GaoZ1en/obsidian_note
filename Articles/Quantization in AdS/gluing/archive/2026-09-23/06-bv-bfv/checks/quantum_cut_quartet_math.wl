checks={};
add[label_,x_]:=AppendTo[checks,<|"label"->label,"passed"->TrueQ[FullSimplify[x]]|>];
ee[n_Integer,z_]:=Sqrt[2n+1]LegendreP[n,2z-1];
vv[n_Integer,z_]:=Integrate[ee[n,u],{u,0,z}];
ww[n_Integer,z_]:=-D[ee[n,z],z];
add["integrated_Legendre_endpoints",And@@Flatten[Table[{vv[n,0]==0,vv[n,1]==0},{n,1,7}]]];
add["integrated_Legendre_derivative",And@@Table[D[vv[n,s],s]==ee[n,s],{n,1,7}]];
add["smooth_dual_biorthogonality",And@@Flatten[Table[Integrate[vv[n,s]ww[m,s],{s,0,1}]==KroneckerDelta[n,m],{n,1,6},{m,1,6}]]];
add["temporal_Legendre_orthogonality",And@@Flatten[Table[Integrate[ee[n,t]ee[m,t],{t,0,1}]==KroneckerDelta[n,m],{n,0,5},{m,0,5}]]];
sf=s(1-s)(1+2s+3s^3);
add["actual_proper_field_projection_exact",FullSimplify[Sum[Integrate[D[sf,s]ee[n,s],{s,0,1}]vv[n,s],{n,1,5}]-sf]==0];
af=1+2s-3s^2+5s^3;
add["antifield_dual_projection_exact",FullSimplify[Sum[Integrate[af vv[n,s],{s,0,1}]ww[n,s],{n,1,5}]-af]==0];
add["all_cap_traces_preserved_on_polynomial_history",FullSimplify[Sum[Integrate[t ee[n,t],{t,0,1}]ee[n,t],{n,0,3}]-t]==0];
add["temporal_caps_not_Neumann",D[t,t]==1];
add["spatial_domain_not_Dirichlet_heat_jet_domain",D[s(1-s),{s,2}]==-2];
add["Legendre_generator_boundary_term",And@@Flatten[Table[{((s(1-s)D[ee[n,s],s])/.s->0)==0,((s(1-s)D[ee[n,s],s])/.s->1)==0},{n,0,5}]]];
add["Legendre_eigenvalue_identity",And@@Table[-D[s(1-s)D[ee[n,s],s],s]==n(n+1)ee[n,s],{n,0,6}]];
add["paired_cut_kernel_trace",And@@Table[Integrate[Sum[vv[n,s]ww[n,s],{n,1,nn}],{s,0,1}]==nn,{nn,1,6}]];
add["proper_history_trace_rank",And@@Flatten[Table[(nt+1)ns==Length[Flatten[Table[{a,b},{a,0,nt},{b,1,ns}],1]],{nt,0,3},{ns,1,4}]]];
add["field_and_antifield_pairing_reconstructed",FullSimplify[Integrate[sf af,{s,0,1}]-Sum[Integrate[D[sf,s]ee[n,s],{s,0,1}]Integrate[af vv[n,s],{s,0,1}],{n,1,5}]]==0];
fourier=Integrate[Exp[-eps bb^2/(2hb^2)+I bb xx/hb]/(2Pi hb),{bb,-Infinity,Infinity},Assumptions->{eps>0,hb>0,Element[xx,Reals]}];
add["normalized_bosonic_Fourier_regularization",FullSimplify[fourier==Exp[-xx^2/(2eps)]/Sqrt[2Pi eps],Assumptions->{eps>0,hb>0,Element[xx,Reals]}]];
add["Fourier_moments_from_delta_derivatives",And@@Flatten[Table[FullSimplify[(-I hb)^b (-1)^b (D[xx^a,{xx,b}]/.xx->0)]==If[a==b,(I hb)^a a!,0],{a,0,5},{b,0,5}]]];
kp={{2,1},{1,3}}; km={{-1,0},{0,1}};
add["positive_gauge_fixing_determinants_cancel",Det[kp]/Abs[Det[kp]]==1];
add["orientation_reversal_has_nonzero_sign_defect",Det[km]/Abs[Det[km]]==-1];
add["gauge_fixing_canonical_shift_has_unit_Berezinian",Det[{{1,0},{1,1}}]/Det[{{1,-1},{0,1}}]==1];
add["unsynchronized_pair_count_does_not_cancel",((nb-ng)/. {nb->3,ng->2})==1];
ExportString[<|"allPassed"->And@@Lookup[checks,"passed"],"count"->Length[checks],"checks"->checks|>,"RawJSON"]
