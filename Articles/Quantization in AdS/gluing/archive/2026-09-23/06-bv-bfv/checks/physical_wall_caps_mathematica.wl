ClearAll["Global`*"];

checks={};
ck[l_,e_]:=AppendTo[checks,<|"label"->l,"passed"->TrueQ[FullSimplify[e]]|>];
ph1=e[t,s]+r[t,s]/2;ph2=e[t,s]-r[t,s]/2;
lg=kap/2(D[ph1,s]D[ph1,t]-D[ph2,s]D[ph2,t])-kap qq[t,s]D[ph1-ph2,s];
lg2=kap/2(D[e[t,s],s]D[r[t,s],t]+D[r[t,s],s]D[e[t,s],t])-kap qq[t,s]D[r[t,s],s];
ck["seam_primitive_change_of_variables",lg==lg2];
capdiv=kap/2(D[D[e[t,s],s]r[t,s],t]-D[D[e[t,s],t]r[t,s],s]);
ck["seam_action_cap_and_endpoint_terms",lg==kap D[r[t,s],s](D[e[t,s],t]-qq[t,s])+capdiv];
shifted=lg2/.{Derivative[1,0][e][t,s]->D[e[t,s],t]+D[ch[t,s],t],Derivative[0,1][e][t,s]->D[e[t,s],s]+D[ch[t,s],s],qq[t,s]->qq[t,s]+D[ch[t,s],t]};
gdiv=kap/2(D[D[ch[t,s],s]r[t,s],t]-D[D[ch[t,s],t]r[t,s],s]);
ck["finite_diagonal_source_covariance",shifted-lg2==gdiv];
th=kap/2(D[e[t,s],s]dr[t,s]+D[r[t,s],s]de[t,s]);
df=kap/2(D[de[t,s],s]r[t,s]+D[e[t,s],s]dr[t,s]);
ck["cap_potential_keeps_spatial_corner",th-df-kap D[r[t,s],s]de[t,s]==-kap/2 D[r[t,s]de[t,s],s]];
rv=s;cv=t s(1-s); ev=t+s+s^2;
diffint=Integrate[(gdiv/.{r->Function[{tt,ss},ss],ch->Function[{tt,ss},tt ss(1-ss)]}),{t,0,1},{s,0,1}];
mu[u_]:=(kap Integrate[cv D[rv,s],{s,0,1}])/.t->u;
ck["proper_cut_ghost_cap_witness",diffint==-(mu[1]-mu[0])/2&&diffint==-kap/12];
ck["endpoint_pairing_nonzero_before_release",((r[t,s]de[t,s]/.{r->Function[{tt,ss},ss],de->Function[{tt,ss},ss]})/.s->1)-((r[t,s]de[t,s]/.{r->Function[{tt,ss},ss],de->Function[{tt,ss},ss]})/.s->0)==1];
ck["mean_zero_source_probes_miss_constant_response",Integrate[s(1-s)(s-1/2)cc,{s,0,1}]==0&&Integrate[s(1-s)cc,{s,0,1}]==cc/6];
ck["primitive_constraint_inverse_keeps_endpoint",Integrate[D[ss+2ss^2+ss^3,ss],{ss,0,s}]==s+2s^2+s^3];
ass=Element[n,Integers]&&n>0&&kap>0&&kk>0&&hb>0;
phi=ac Cos[n s]+bc Sin[n s];dphi=dac Cos[n s]+dbc Sin[n s];
theta=kap/2 Integrate[D[phi,s]dphi,{s,0,2 Pi},Assumptions->ass];
hen=kap vv/2 Integrate[D[phi,s]^2,{s,0,2 Pi},Assumptions->ass];
jn=kap Integrate[Exp[I n s]D[phi,s],{s,0,2 Pi},Assumptions->ass];
ck["actual_edge_cap_potential",FullSimplify[theta==kap Pi n/2(bc dac-ac dbc),ass]];
ck["actual_wall_energy_modes",FullSimplify[hen==kap Pi vv n^2/2(ac^2+bc^2),ass]];
ck["current_mode_phase_normalization",FullSimplify[jn==kap Pi n(bc-I ac),ass]];
qqc=Sqrt[kk n/2]ac;ppc=Sqrt[kk n/2]bc;
ck["Darboux_cap_coefficient",D[theta/.{dac->1,dbc->0},bc]-D[theta/.{dac->0,dbc->1},ac]==kap Pi n];
ck["Darboux_wall_harmonic_energy",FullSimplify[(hen/.kap->kk/(2 Pi))-vv n/2(qqc^2+ppc^2),ass]==0];
zz=(ppc-I qqc)/Sqrt[2 hb];
ck["QD_annihilator_from_cap_modes",FullSimplify[(jn/.kap->kk/(2 Pi))-Sqrt[hb kk n]zz,ass]==0];
thout=I hb/2(zbf dzf-zf dzbf);
thin=-I hb/2(zbi dzi-zi dzbi);
cfout=-I hb/2(zbf dzf+zf dzbf);
cfin=-I hb/2(zbi dzi+zi dzbi);
ck["coherent_cap_variation",thout+cfout==-I hb zf dzbf&&thin+cfin==-I hb zbi dzi];
zpath=zin Exp[-I om t];bpath=zbout Exp[I om(t-tt)];
lcoh=I hb/2(bpath D[zpath,t]-D[bpath,t]zpath)-hb om bpath zpath;
ck["coherent_classical_bulk_action_zero",lcoh==0];
capact=-I hb/2((bpath zpath/.t->tt)+(bpath zpath/.t->0));
ck["coherent_polarized_on_shell_action",capact==-I hb zbout zin Exp[-I om tt]];
kernel=Exp[zbout zin Exp[-I om tt]];
ck["cap_kernel_Schrodinger_equation",I hb D[kernel,tt]==hb om zbout D[kernel,zbout]];
gauss=Integrate[Exp[-xx^2-yy^2+aa(xx+I yy)+bb(xx-I yy)]/Pi,{xx,-Infinity,Infinity},{yy,-Infinity,Infinity},GenerateConditions->False];
ck["actual_Bargmann_gluing_integral",gauss==Exp[aa bb]];
ck["cap_composition_time_additivity",Exp[-I om t2]Exp[-I om t1]==Exp[-I om(t1+t2)]];
ck["normal_ordering_scalar_is_declared",Sum[hb vv m/2,{m,1,mm}]==hb vv mm(mm+1)/4];
ck["corner_measure_cannot_be_dropped",Integrate[2 rho,{rho,0,rr}]==rr^2&&Integrate[2 rho Exp[-rho^2],{rho,0,Infinity}]==1];
ck["current_two_point_sum",FullSimplify[Sum[j z^j,{j,1,Infinity}],Assumptions->Abs[z]<1]==z/(1-z)^2];
fm=Integrate[Exp[-I (2h+1)s],{s,0,Pi},Assumptions->Element[h,Integers]&&h>=0]/(2 Pi);
ck["sharp_half_arc_Fourier_coefficient",FullSimplify[fm,Assumptions->Element[h,Integers]&&h>=0]==-I/(Pi(2h+1))];
ck["sharp_energy_vacuum_sum",FullSimplify[Sum[(2j+1)-1/(2j+1),{j,0,rr}],Assumptions->Element[rr,Integers]&&rr>=0]==(rr+1)^2-HarmonicNumber[2rr+1]+HarmonicNumber[rr]/2];
ck["sharp_time_window_still_has_tail",FullSimplify[Integrate[Exp[-I (2h+1)vv t],{t,0,Pi/vv}],Assumptions->Element[h,Integers]&&h>=0&&vv>0]==-2 I/((2h+1)vv)];
fourierReg=Integrate[Exp[-eps qv^2/(2 hb^2)-I qv piv/hb]/(2 Pi hb),{qv,-Infinity,Infinity},Assumptions->eps>0&&hb>0&&Element[piv,Reals]];
ck["normalized_source_Fourier_delta",FullSimplify[fourierReg==Exp[-piv^2/(2 eps)]/Sqrt[2 Pi eps],eps>0&&hb>0&&Element[piv,Reals]]];
testedDelta=Integrate[Exp[-piv^2/(2 eps)]/Sqrt[2 Pi eps]*Exp[-aa0 piv^2+I bv0 piv],{piv,-Infinity,Infinity},Assumptions->eps>0&&aa0>0&&Element[bv0,Reals]];
ck["source_release_kills_shift_phase",Limit[testedDelta,eps->0,Direction->"FromAbove"]==1];
ExportString[<|"allPassed"->And@@Lookup[checks,"passed"],"count"->Length[checks],"checks"->checks|>,"RawJSON"]
