ClearAll["BVQcheck`*"];
Begin["BVQcheck`"];
tests={};
check[label_,expr_] := AppendTo[tests,<|"label"->label,"passed"->TrueQ[FullSimplify[expr]]|>];
pauli={{{0,1},{1,0}},{{0,-I},{I,0}},{{1,0},{0,-1}}};
tt=(-I/2)#& /@ pauli; eye=IdentityMatrix[2];
comm[a_,b_]:=a.b-b.a;
check["su2_structure_constants",comm[tt[[1]],tt[[2]]]==tt[[3]]&&comm[tt[[2]],tt[[3]]]==tt[[1]]&&comm[tt[[3]],tt[[1]]]==tt[[2]]];
jr[s_]:=a(Cos[s]tt[[1]]+Sin[s]tt[[2]]);
rr[s_]:=Cos[s/2]eye+2 Sin[s/2]tt[[3]];
check["smooth_zero_mean_current",Integrate[jr[s],{s,0,2 Pi}]==ConstantArray[0,{2,2}]];
check["rotating_current_adjoint",jr[s]==rr[s].(a tt[[1]]).rr[-s]];
ev[s_]:=Cos[s Sqrt[1+a^2]/2]eye+2 Sin[s Sqrt[1+a^2]/2]/Sqrt[1+a^2](a tt[[1]]+tt[[3]]);
gg[s_]:=ev[s].rr[-s];
check["exact_holonomy_ode",D[gg[s],s]==gg[s].jr[s]];
check["holonomy_initial_value",gg[0]==eye];
check["zero_mean_nontrivial_holonomy",FullSimplify[gg[2 Pi]/.a->Sqrt[3]]==-eye];
series2[e_]:=(e/.a->0)+a(D[e,a]/.a->0)+a^2(D[e,{a,2}]/.a->0)/2;
check["holonomy_second_order",Map[series2,gg[2 Pi],{2}]==eye+Pi a^2 tt[[3]]];
rot[s_]:={{Cos[2s],-Sin[2s],0},{Sin[2s],Cos[2s],0},{0,0,1}};
wv[s_]:={Cos[3s],Sin[2s],Cos[s]};
prim[s_]:={Sin[3s]/3,(1-Cos[2s])/2,Sin[s]};
eta[s_]:=Transpose[rot[s]].wv[s];
xi[s_]:=Transpose[rot[s]].prim[s];
check["covariant_primitive",D[xi[s],s]+Cross[{0,0,2},xi[s]]==eta[s]];
check["tangent_holonomy_constraint",Integrate[rot[s].eta[s],{s,0,2 Pi}]=={0,0,0}];
check["periodic_covariant_primitive",xi[0]=={0,0,0}&&xi[2 Pi]=={0,0,0}];
cc={c1,c2,c3}; par[s_]:=Transpose[rot[s]].cc;
check["parallel_stabilizer_retained",D[par[s],s]+Cross[{0,0,2},par[s]]=={0,0,0}];
alpha={al1,al2,al3}; beta={be1,be2,be3}; jv={j1,j2,j3};
check["current_bracket_lie_sign",alpha.Cross[jv,beta]==-Cross[alpha,beta].jv];
check["energy_nonlinear_term_zero",Cross[jv,jv]=={0,0,0}];
qvec={q0,q1,q2,q3}; ns=qvec.qvec;
qmat=q0 eye-I Sum[qvec[[b+1]]pauli[[b]],{b,1,3}];
check["sphere_projection_unitary",FullSimplify[ConjugateTranspose[qmat/Sqrt[ns]].(qmat/Sqrt[ns]),Assumptions->Element[qvec,Reals]&&ns>0]==eye];
check["sphere_projection_determinant",FullSimplify[Det[qmat/Sqrt[ns]],Assumptions->Element[qvec,Reals]&&ns>0]==1];
check["reflection_vacuum_norm",Sum[hb^2 n^2/2,{n,1,cut}]==hb^2 cut(cut+1)(2cut+1)/12];
check["virasoro_vacuum_cocycle",FullSimplify[Sum[r(m-r)/2,{r,1,m-1}],Assumptions->Element[m,Integers]&&m>=2]==(m^3-m)/12];
check["stress_classical_bracket_coefficient",I n-I(m+n)/2==I(n-m)/2];
check["energy_normalization",2 Pi kap v/(2(2 Pi kap)^2)==v/(2(2 Pi kap))];
check["first_mode_has_zero_vacuum_stress",Sum[r(1-r)/2,{r,1,0}]==0];

soft=I(Jm^2-Jp^2)/(2 kk nn);
check["complete_flow_positive_mode",-I kk nn D[soft,Jm]==Jm];
check["complete_flow_negative_mode",I kk nn D[soft,Jp]==Jp];
check["uniform_squeeze_flow",MatrixExp[tau {{0,1},{1,0}}]=={{Cosh[tau],Sinh[tau]},{Sinh[tau],Cosh[tau]}}];
check["complete_flow_vacuum_norm",Sum[hb^2/2,{n,1,cut}]==hb^2 cut/2];

End[];
ExportString[<|"allPassed"->And@@Lookup[BVQcheck`tests,"passed"],"count"->Length[BVQcheck`tests],"checks"->BVQcheck`tests|>,"RawJSON"]
