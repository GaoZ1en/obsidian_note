ClearAll["NBVcheck`*"];
Begin["NBVcheck`"];
tests={};
check[label_,v_] := AppendTo[tests,<|"label"->label,"passed"->TrueQ[FullSimplify[v]]|>];
ff1[t_]:=a0+a1 t+a2 t^2+a3 t^3+a4 t^4;
ff2[t_]:=a0+b1 t+b2 t^2+b3 t^3+b4 t^4;
ff3[t_]:=a0+(a1+b1)t+c2 t^2+c3 t^3+c4 t^4;
rr[t_]:=Expand[ff3[t]-ff1[t]-ff2[t]+a0];
hh[t_]=Cancel[rr[t]/t^2];
ext[x_,y_]:=ff1[x]+ff2[y]-a0+x y hh[x];
check["junction_point_values_agree",({t,t,0}/.t->0)=={0,0,0}];
check["junction_derivative_contradiction",D[t,t]+D[t,t]-D[0,t]==2];
check["extension_x_axis",ext[x,0]==ff1[x]];
check["extension_y_axis",ext[0,y]==ff2[y]];
check["extension_diagonal",ext[t,t]==ff3[t]];
check["Hadamard_continuous_formula",hh[t]==Integrate[(1-u)(D[rr[z],{z,2}]/.z->u t),{u,0,1}]];
p0[f_]:=(f/.x->0)+(f/.y->0)-(f/.{x->0,y->0});
p1[a_List]:={a[[1]]/.y->0,a[[2]]/.x->0};
h1[a_List]:=Integrate[(a[[1]]/.x->u)-(a[[1]]/.{x->u,y->0}),{u,0,x}];
h2[b_]:={0,Integrate[b/.x->u,{u,0,x}]};
d0[f_]:={D[f,x],D[f,y]};
d1[a_List]:=D[a[[2]],x]-D[a[[1]],y];
f=a0+a1 x+b1 y+a2 x y+a3 x^2 y^2;
aa={a0+a1 x+a2 x y+a3 y^2,b1+b2 x y+b3 x^2};
bb=c2+c3 x+c4 x y;
check["toy_chain_on_functions",p1[d0[f]]==d0[p0[f]]];
check["toy_homotopy_degree_zero",h1[d0[f]]==f-p0[f]];
check["toy_homotopy_degree_one",d0[h1[aa]]+h2[d1[aa]]==aa-p1[aa]];
check["toy_homotopy_degree_two",d1[h2[bb]]==bb];
check["toy_preserves_exterior_trace",(p0[f]/.y->0)==(f/.y->0)];
br0=x y;
check["smoothing_not_Lie_on_functions",p0[br0]-p0[x]p0[y]==-x y];
bracketDefect=-x y;
corr={0,-x^2 y/2};
check["nonzero_binary_bracket_defect",bracketDefect==-x y];
check["binary_defect_homotopy",d1[corr]==bracketDefect];
check["binary_correction_relative",(corr[[1]]/.y->0)==0];
avec={a[t,z],b[t,z],c[t,z]};
check["nonabelian_chiral_wall_bracket_zero",Cross[v avec,avec]=={0,0,0}];
curv=D[avec,t]-D[v avec,z]+lam Cross[v avec,avec];
check["nonabelian_wall_curvature",curv==D[avec,t]-v D[avec,z]];

at={at1,at2,at3}; ax={ax1,ax2,ax3}; ay={ay1,ay2,ay3};
vary={da1,da2,da3};
cubic=kap lam at.Cross[ax,ay];
check["CS_cubic_variation_normalization",D[cubic/.at->at,at1] vary[[1]]+D[cubic,at2] vary[[2]]+D[cubic,at3] vary[[3]]==kap lam vary.Cross[ax,ay]];
check["formal_series_zero_radius_ratio",FullSimplify[(n+1)!/n!,Assumptions->Element[n,Integers]&&n>=0]==n+1];

d3[a_List]:={D[a[[2]],t]-D[a[[1]],x],D[a[[3]],t]-D[a[[1]],y],D[a[[3]],x]-D[a[[2]],y]};
w3[a_List,b_List]:={a[[1]]b[[2]]-a[[2]]b[[1]],a[[1]]b[[3]]-a[[3]]b[[1]],a[[2]]b[[3]]-a[[3]]b[[2]]};
p31[a_List]:={p0[a[[1]]],a[[2]]/.y->0,a[[3]]/.x->0};
p32[a_List]:={a[[1]]/.y->0,a[[2]]/.x->0,0};
physA={v,1,0}; physB={0,0,y}; physC={0,0,-x y};
physDef=p32[w3[physA,physB]]-w3[p31[physA],p31[physB]];
check["physical_counterexample_wall_domain",And[(physA[[1]]-v physA[[2]]/.y->0)==0,(physB[[1]]-v physB[[2]]/.y->0)==0]];
check["physical_counterexample_closed_inputs",d3[physA]=={0,0,0}&&d3[physB]=={0,0,0}];
check["physical_counterexample_bracket_defect",physDef=={0,0,-y}];
check["physical_counterexample_primitive",d3[physC]==physDef];
check["physical_counterexample_relative_primitive",(physC[[{1,2}]]/.y->0)=={0,0}];

End[];
ExportString[<|"allPassed"->And@@Lookup[NBVcheck`tests,"passed"],"count"->Length[NBVcheck`tests],"checks"->NBVcheck`tests|>,"RawJSON"]
