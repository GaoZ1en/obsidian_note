ClearAll["Global`*"];
checks=<||>; residuals=<||>;
add[label_,expr_]:=Module[{r=FullSimplify[expr]},
 AssociateTo[checks,label->And@@(TrueQ[#==0]&/@Flatten[{r}])];
 AssociateTo[residuals,label->ToString[r,InputForm]]];
tb=Table[-I PauliMatrix[j]/2,{j,3}];
comm[a_,b_]:=a.b-b.a;
zz=Array[z,{2,2}]; zv=Flatten[zz];
lv=Table[Flatten[zz.tb[[j]]],{j,3}];
rv=Table[Flatten[tb[[j]].zz],{j,3}];
dir[v_,f_,xs_]:=Sum[v[[j]] D[f,xs[[j]]],{j,Length[xs]}];
lie[v_,w_,xs_]:=dir[v,w,xs]-dir[w,v,xs];
add["LeftLieBracket",Table[lie[lv[[j]],lv[[k]],zv]-Flatten[zz.comm[tb[[j]],tb[[k]]]],{j,3},{k,3}]];
add["RightLieBracket",Table[lie[rv[[j]],rv[[k]],zv]+Flatten[comm[tb[[j]],tb[[k]]].zz],{j,3},{k,3}]];
add["LeftRightCommute",Table[lie[lv[[j]],rv[[k]],zv],{j,3},{k,3}]];
add["TangentToDeterminant",Table[{dir[lv[[j]],Det[zz],zv],dir[rv[[j]],Det[zz],zv]},{j,3}]];
ff=zz[[1,1]]^2 zz[[2,2]]+zz[[1,2]] zz[[2,1]]+zz[[1,1]];
hh=zz[[1,2]]^2+zz[[2,2]];
p[j_,f_]:=-I hb dir[lv[[j]],f,zv];
add["HolonomyFluxCommutator",Table[ff p[j,hh]-p[j,ff hh]-I hb dir[lv[[j]],ff,zv] hh,{j,3}]];
add["FluxCommutatorSign",Table[p[j,p[k,ff]]-p[k,p[j,ff]]+hb^2 dir[Flatten[zz.comm[tb[[j]],tb[[k]]]],ff,zv],{j,3},{k,3}]];
lap[vv_,f_,xs_]:=Sum[dir[vv[[j]],dir[vv[[j]],f,xs],xs],{j,3}];
add["FundamentalCasimir",lap[lv,zz,zv]+3 zz/4];
add["LeftRightCasimir",lap[lv,ff,zv]-lap[rv,ff,zv]];
aa=Array[a,{2,2}]; bb=Array[b,{2,2}]; xs=Join[Flatten[aa],Flatten[bb]]; uu=bb.aa;
l1=Table[Join[Flatten[aa.tb[[j]]],ConstantArray[0,4]],{j,3}];
r1=Table[Join[Flatten[tb[[j]].aa],ConstantArray[0,4]],{j,3}];
l2=Table[Join[ConstantArray[0,4],Flatten[bb.tb[[j]]]],{j,3}];
r2=Table[Join[ConstantArray[0,4],Flatten[tb[[j]].bb]],{j,3}];
cut=r1-l2;
kf=ff/.Thread[zv->Flatten[uu]];
add["CutAnnihilatesProductHolonomy",Table[dir[cut[[j]],uu,xs],{j,3}]];
add["AdaptedCutCoordinate",Table[dir[cut[[j]],bb,xs]+bb.tb[[j]],{j,3}]];
add["FirstFluxIntertwining",Table[dir[l1[[j]],kf,xs]-(dir[lv[[j]],ff,zv]/.Thread[zv->Flatten[uu]]),{j,3}]];
add["LastRightFluxIntertwining",Table[dir[r2[[j]],kf,xs]-(dir[rv[[j]],ff,zv]/.Thread[zv->Flatten[uu]]),{j,3}]];
globalLap=lap[lv,ff,zv]/.Thread[zv->Flatten[uu]];
add["FirstCasimirIntertwining",lap[l1,kf,xs]-globalLap];
add["SecondCasimirIntertwining",lap[l2,kf,xs]-globalLap];
add["LengthWeightedHamiltonian",-(ee hb^2/2)(ell1 lap[l1,kf,xs]+ell2 lap[l2,kf,xs])+(ee hb^2/2)(ell1+ell2)globalLap];
add["CutMomentCommutesFirstCasimir",Table[dir[cut[[j]],lap[l1,kf+aa[[1,1]],xs],xs]-lap[l1,dir[cut[[j]],kf+aa[[1,1]],xs],xs],{j,3}]];
add["CutMomentCommutesSecondCasimir",Table[dir[cut[[j]],lap[l2,kf+bb[[1,1]],xs],xs]-lap[l2,dir[cut[[j]],kf+bb[[1,1]],xs],xs],{j,3}]];
add["CommonHistoryCancels",Sum[qq[j] dir[cut[[j]],kf,xs],{j,3}]];
ug1=(3 IdentityMatrix[2]+4 I PauliMatrix[1])/5;
ug2=(5 IdentityMatrix[2]+12 I PauliMatrix[2])/13;
ug3=(8 IdentityMatrix[2]+15 I PauliMatrix[3])/17;
ad[u_,v_]:=u.v.Inverse[u]; ip[v_,w_]:=-2 Tr[v.w];
mat[v_]:=Sum[v[[j]] tb[[j]],{j,3}];
pm=mat[{p1,p2,p3}]; pn=mat[{s1,s2,s3}];
xi=mat[{x1,x2,x3}]; eta=mat[{y1,y2,y3}];
u=ug2.ug1; mu=ad[ug1,pm]-pn; nu=ad[ug2,pn]-ad[u,pm];
add["InvariantVerticalMomentSign",nu+ad[ug2,mu]];
add["AdaptedCotangentPotential",ip[pm,Inverse[u].eta-Inverse[u].xi.Inverse[ug2].u]+ip[pn,Inverse[ug2].xi]-
 (ip[pm,Inverse[u].eta]+ip[nu,xi.Inverse[ug2]])];
add["VerticalMomentCutInvariant",ad[ug2.Inverse[ug3],ad[ug3,pn]]-ad[u,pm]-nu];
add["WilsonThreeCellAssociativity",(ug3.ug2).ug1-ug3.(ug2.ug1)];
add["ElectricInsertionClassicalSymbol",ug2.ad[ug1,pm].ug1-u.pm];
haarNorm=Integrate[2 Sin[th] Cos[th],{th,0,Pi/2}];
haarMean=Integrate[Exp[I ph],{ph,0,2 Pi}]/(2 Pi);
haarSquare=Integrate[2 Sin[th] Cos[th]^3,{th,0,Pi/2}];
add["NormalizedHaar",haarNorm-1];
add["HaarZeroMean",haarMean];
add["HaarNonmultiplicativityWitness",haarSquare-1/2];
kernel=fun[t1-t3,t2-t3,x1,x2,x3];
add["CommonTimeDerivative",D[kernel,t1]+D[kernel,t2]+D[kernel,t3]];
add["MovingDeltaConormal",D[rr-tt,{{tt,rr}}]-{-1,1}];
add["CommonTimeCovectorSum",Total[{s1,s2,s3-s1-s2}]-s3];
add["FiniteTimeNonrealWitness",Exp[I Pi/2]-I];
result=<|"Scope"->"Exact finite algebraic diagnostics; not general PBW, microlocal, or analytic proofs",
 "Checks"->checks,"Residuals"->residuals,"CheckCount"->Length[checks],
 "AllChecksPassed"->And@@Values[checks]|>;
Print[ExportString[result,"RawJSON"]];
If[!TrueQ[result["AllChecksPassed"]],Exit[1]];
