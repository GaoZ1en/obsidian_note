862ee63f7d85"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cotton", "::", "usage"}], " ", "=",
   "\"\<Cotton[signatureg_] : Cotton tensor of a 3d metric\nNeeded : \
RGTensors executed on that metric\nInput: Signature (+1 or -1) of the metric\n\
Output: CotUd and Cotdd and the epsilon tensors : epsddd, epsUUU \nConvention \
: epsUUU[[1,2,3]] = + 1 / Sqrt[Abs[detg]]\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449077651859375*^9, 3.449077661015625*^9}, {
  3.449077722109375*^9,
  3.449077840984375*^9}},ExpressionUUID->"783c2186-5113-4d74-b0bd-\
e2768639dcfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cotton", "[", "signatureg_Integer", "]"}], " ", ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"g2dd", ",", "g2ddjd"}], "}"}], ",", " ", "\[IndentingNewLine]",
    RowBox[{
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"ValueQ", "[", "gdd", "]"}], " ", "&&", " ",
        RowBox[{"ValueQ", "[", "Rdd", "]"}], " ", "&&", " ",
        RowBox[{"ValueQ", "[", "R", "]"}], " ", "&&",
        RowBox[{"ValueQ", "[", "detg", "]"}]}], ",", ",",
       RowBox[{
        RowBox[{
        "Print", "[",
         "\"\<RGtensors should be executed prior to this procedure.\>\"",
         "]"}], ";", " ",
        RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";",
     "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "gdd", "]"}], " ", "=!=", " ",
        RowBox[{"{",
         RowBox[{"3", ",", "3"}], "}"}]}], ",",
       RowBox[{
        RowBox[{
        "Print", "[",
         "\"\<The Cotton tensor exists only in 3 dimensions. Incoherent \
dimensions detected.\>\"", "]"}], ";", " ",
        RowBox[{"Return", "[", "]"}], ";"}]}], " ", "]"}], ";",
     "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"ValueQ", "[", "epsUUU", "]"}], " ", "||", " ",
        RowBox[{"ValueQ", "[", "epsddd", "]"}], " ", "||", " ",
        RowBox[{"ValueQ", "[", "CotUd", "]"}], " ", "||", " ",
        RowBox[{"ValueQ", "[", "Cotdd", "]"}]}], " ", ",",
       RowBox[{
        RowBox[{
        "Print", "[",
         "\"\<Variables epsUUU, epsddd, CotUd, Cotdd already assigned. They \
will be updated.\>\"", "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
        RowBox[{"signatureg", " ", "=!=", "  ",
         RowBox[{"-", "1"}]}]}], " ", ",",
       RowBox[{
        RowBox[{"Return", "[", "\"\<Incoherent signature detected\>\"", "]"}],
         ";"}], ",", " ",
       RowBox[{
        RowBox[{"Print", "[",
         RowBox[{
         "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
          "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", " ",
     "\[IndentingNewLine]",
     RowBox[{"g2dd", " ", "=", " ",
      RowBox[{"Rdd", "-",
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", "gdd", " ", "R"}]}]}], ";",
     "\[IndentingNewLine]",
     RowBox[{"epsUUU", " ", "=", " ",
      RowBox[{
       RowBox[{"1", "/", " ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}]}], " ", " ",
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",",
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",",
             RowBox[{"-", "1"}]}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{
             RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}]}],
     ";", "\[IndentingNewLine]",
     RowBox[{"epsddd", " ", "=", " ",
      RowBox[{"signatureg", " ",
       RowBox[{"Sqrt", "[",
        RowBox[{"signatureg", " ", "detg"}], "]"}], " ", " ",
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",",
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",",
             RowBox[{"-", "1"}]}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{
             RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}]}],
     ";", "\[IndentingNewLine]",
     RowBox[{"g2ddjd", " ", "=", " ",
      RowBox[{"covD", "[", "g2dd", "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{"CotUd", " ", "=", " ",
      RowBox[{"multiDot", "[",
       RowBox[{"epsUUU", ",", "g2ddjd", ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ";",
     "\[IndentingNewLine]",
     RowBox[{"Cotdd", " ", "=", " ",
      RowBox[{"Lower", "[",
       RowBox[{"CotUd", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{
     "Print", "[", "\"\<epsUUU,epsddd,CotUd,Cotdd have been computed.\>\"",
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
