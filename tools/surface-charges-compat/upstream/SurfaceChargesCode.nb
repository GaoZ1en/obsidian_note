Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KomarIntegral", "::", "usage"}], " ", "=", " ",
   "\"\<KomarIntegral[xiU_,signatureg_,{index1_,index2_}] compute the Komar \
Integral in Einstein gravity\nNeed = metric and coord should be defined and \
RGtensors should have been executed prior to this procedure\nInput = A \
Killing vector or asymptotic Killing vector 'xiU' \n\t    The signature of \
the metric 'signatureg' (1 or -1)\n        A surface of codimension 2 \
specified by the two indices '{index1,index2}' in the coordinates coord that \
are fixed\nOutput = The components {index1,index2} of the Komar integral \
associated with the vector xiU\nConvention : The Komar integral has the form \
1/(16\[Pi]) Sqrt[signatureg g] (\!\(\*SuperscriptBox[\(D\), \(\[Alpha]\)]\)\!\
\(\*SuperscriptBox[\(xiU\), \(\[Beta]\)]\)-\!\(\*SuperscriptBox[\(D\), \(\
\[Beta]\)]\)\!\(\*SuperscriptBox[\(xiU\), \
\(\[Alpha]\)]\))(\!\(\*SuperscriptBox[\(d\), \(n - 2\)]\)x\!\(\*SubscriptBox[\
\()\), \(\[Alpha]\[Beta]\)]\)\n\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
  3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
  3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
  3.449405217921875*^9, 3.449405298078125*^9}, {3.4494055233125*^9,
