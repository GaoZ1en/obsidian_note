4974831c06ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LiediffU", "[",
    RowBox[{"vector2_List", ",", "coord_List", ",", "vector_List"}], "]"}], ":=",
   RowBox[{
    RowBox[{"Table", "[", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"Sum", "[",
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"D", "[",
           RowBox[{
            RowBox[{"vector2", "[",
             RowBox[{"[", "indmu", "]"}], "]"}], ",",
            RowBox[{"coord", "[",
             RowBox[{"[", "indrho", "]"}], "]"}]}], "]"}],
          RowBox[{"vector", "[",
           RowBox[{"[", "indrho", "]"}], "]"}]}], "-",
         RowBox[{
          RowBox[{"D", "[",
           RowBox[{
            RowBox[{"vector", "[",
             RowBox[{"[", "indmu", "]"}], "]"}], ",",
            RowBox[{"coord", "[",
             RowBox[{"[", "indrho", "]"}], "]"}]}], "]"}],
          RowBox[{"vector2", "[",
           RowBox[{"[", "indrho", "]"}], "]"}]}]}], ",",
        "\[IndentingNewLine]",
        RowBox[{"{",
         RowBox[{"indrho", ",", " ",
          RowBox[{"Length", "[", "coord", "]"}]}], "}"}]}], "]"}], ",",
      RowBox[{"{",
       RowBox[{"indmu", ",", " ",
        RowBox[{"Length", "[", "vector2", "]"}]}], "}"}]}], "]"}], " ", "/;",
    " ",
    RowBox[{
     RowBox[{
      RowBox[{"Dimensions", "[", "vector", "]"}], "\[Equal]", " ",
      RowBox[{"Dimensions", "[", "vector2", "]"}]}], "&&",
     RowBox[{
      RowBox[{"Dimensions", "[", "vector", "]"}], "\[Equal]", " ",
      RowBox[{"Dimensions", "[", "coord", "]"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.4389737450625*^9, {3.442359814538684*^9, 3.44235993871132*^9}, {
   3.44236011758632*^9, 3.442360118414445*^9}, {3.444751585335341*^9,
