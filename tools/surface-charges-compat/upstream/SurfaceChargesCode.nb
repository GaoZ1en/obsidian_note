Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesTMG", "::", "usage"}], " ", "=", " ",
   "\"\<ChargesTMG[xiU_,hdd_,mu_,{signatureg_,signepsUUU_},{index1_,index2_}] \
compute the surface charge in Topologically massive gravity\nNeed = metric \
and coord should be defined and RGtensors[...] should have been executed \
prior to this procedure\nInput = A Killing vector or asymptotic Killing \
vector 'xiU' \n        A metric perturbation 'hdd'\n\t    The signature of \
the metric 'signatureg' (1 or -1) and the convention for the epsilon tensor \
with upper indices \n               eps^{123} = 'signepsUUU' where 123 is the \
order of the coordinates 'coord'\n        mu : Gravitational Chern-Simons \
coupling\n        A surface of codimension 2 specified by the two indices \
'{index1,index2}' in the coordinates coord that are fixed\nOutput = The \
components {index1,index2} of the surface charge associated with the vector \
xiU under the perturbation\nExtra output : ChargeSuppl : supplementary term \
with respect to the covariant phase space formula.\nConvention : The \
Lagrangian has the form (1/(16\[Pi]) Sqrt[signatureg g] (R + 1/mu Topological \
Chern-Simons). \n             The equations of motion are G_{\\mu\\nu}+1/mu \
C_{\\mu\\nu} = 0\nOrigin : The formulae are taken from 0808.1911. The charges \
-('Charges' - 'ChargeSuppl') are equal to the charges defined in 0706.0263.\n\
\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
   3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
   3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
   3.449405217921875*^9, 3.449405298078125*^9}, {3.4494055233125*^9,
   3.4494055234375*^9}, {3.449406790140625*^9, 3.449406867671875*^9}, {
   3.44940690228125*^9, 3.4494071323125*^9}, {3.449407526953125*^9,
   3.44940755871875*^9}, {3.4494077844375*^9, 3.44940792065625*^9},
   3.45373461040625*^9},ExpressionUUID->"e2efa0af-c9cd-44fe-92de-\
2afd8d5faffa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesTMG", "[",
    RowBox[{"xiU_List", ",", "hdd_List", ",", "mu_", ",",
     RowBox[{"{",
      RowBox[{"signatureg_Integer", ",", "signepsUUU_Integer"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}]}], "]"}], " ",
   ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
      "hUd", ",", "hUU", ",", "deth", ",", "xid", ",", "xidjd", ",", "xiUjd",
       ",", "dethjd", ",", "dethjU", ",", "hUUjd", ",", "hUUjU", ",", "xidjU",
        ",", "epsUUU", ",", "etaU", ",", "xitotU", ",", "xitotd", ",",
       "xitotUjd", ",", "xitotUjU", ",", "IntegrandEUU", " ", ",", "result1",
       ",", "KillingUd", ",", "hddjd", ",", "hddjdjd", ",", "dethjdjd", ",",
       "hddjdjU", ",", "Boxhdd", ",", "linRcdd", ",", "linRccontr", ",",
       "handR", ",", "linEindd", ",", "hEUd", ",", "\[IndentingNewLine]",
       "linEinUd", ",", "linEincontr", ",", "temp1UUU", ",", "xidualUU", ",",
       "temp1dd", ",", "temp1", ",", "temp2d", ",", "KillingUdjd", ",",
       "temp1d", ",", "resultCS", ",", "Charge", ",", "Integrand1UU", " ",
       ",", "Integrand2UU", ",", "ContribCS1UU", ",", "ContribCS2UU", " ",
       ",", "ContribCS3UU"}], "}"}], ",", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "gdd", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Raise\>\"", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Lower\>\"", "]"}], "&&",
         RowBox[{"NameQ", "[", "\"\<covD\>\"", " ", "]"}], "&&",
         RowBox[{"ValueQ", "[", "gUU", "]"}], " ", "&&",
         RowBox[{"ValueQ", "[", "detg", "]"}], "  ", "&&",
         RowBox[{"NameQ", "[", "\"\<multiDot\>\"", "]"}], "&&",
         RowBox[{"NameQ", "[", "\"\<Contract\>\"", "]"}], "&&",
         RowBox[{"ValueQ", "[", "EUd", "]"}], "  ", "&&",
         RowBox[{"ValueQ", "[", "R", "]"}]}], ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<RGtensors should be executed prior to this procedure.\>\"",
          "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "coord", "]"}], " ", "&&", " ",
         RowBox[{"ValueQ", "[", "metric", "]"}]}], "   ", ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<metric and coord not defined.\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
         RowBox[{"signatureg", " ", "=!=", "  ",
          RowBox[{"-", "1"}]}]}], " ", ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incoherent signature detected\>\"", "]"}], ";"}],
         ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
           "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"signepsUUU", " ", "=!=", "  ", "1"}], " ", "&&", " ",
         RowBox[{"signepsUUU", " ", "=!=", "  ",
          RowBox[{"-", "1"}]}]}], " ", ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incoherent convention for epsilon detected\>\"",
          "]"}], ";"}], ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<Convention for epsilon^{123}: \>\"", ",", "signepsUUU", ",",
           "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "hdd", "]"}], " ", "=!=", "  ",
         RowBox[{"Dimensions", "[", "metric", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], " ", "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
         RowBox[{"Dimensions", "[", "xiU", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&",
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<The surface charge is inversely proportional to Newton \
constant and should be integrated on the \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index1", "]"}], "]"}], ",", "\"\< , \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index2", "]"}], "]"}], ",",
           "\"\< = constant surface\>\""}], "]"}], ";"}],
        "\[IndentingNewLine]", ",",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<Invalid arguments for the choice of n-2 surface\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"hUd", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hdd", ",", "1"}], "]"}]}], ";",
      RowBox[{"hUU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hUd", ",", "2"}], "]"}]}], ";",
      RowBox[{"deth", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"hUd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"xid", " ", "=", " ",
       RowBox[{"Lower", "[",
        RowBox[{"xiU", ",", "1"}], "]"}]}], ";",
      RowBox[{"xiUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"xiU", ",",
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";",
      RowBox[{"xidjd", " ", "=", " ",
       RowBox[{"covD", "[", "xid", "]"}]}], ";",
      RowBox[{"xidjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"xidjd", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"dethjd", " ", "=", " ",
       RowBox[{"covD", "[", "deth", "]"}]}], ";",
      RowBox[{"dethjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"dethjd", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"hUUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"hUU", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      RowBox[{"hUUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hUUjd", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{
       "Total", " ", "vector", " ", "xitotU", " ", "got", " ", "a", " ",
        "contribution", " ", "from", " ", "TMG"}], " ", "*)"}],
      "\[IndentingNewLine]",
      RowBox[{"epsUUU", " ", "=",
       RowBox[{
        RowBox[{"signepsUUU", "/",
         RowBox[{"Sqrt", "[",
          RowBox[{"signatureg", " ", "detg"}], "]"}]}], " ",
        RowBox[{"{",
         RowBox[{
          RowBox[{"{",
           RowBox[{
            RowBox[{"{",
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"0", ",",
              RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"{",
             RowBox[{"0", ",", "0", ",",
              RowBox[{"-", "1"}]}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], ",",
          RowBox[{"{",
           RowBox[{
            RowBox[{"{",
             RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{
              RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"etaU", " ", "=", " ",
       RowBox[{
        RowBox[{"multiDot", "[",
         RowBox[{"epsUUU", ",", "xidjd", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "2"}], "}"}], ",",
          RowBox[{"{",
           RowBox[{"3", ",", "1"}], "}"}]}], "]"}], "/", "2"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"xitotU", " ", "=", " ",
       RowBox[{"xiU", " ", "+", " ",
        RowBox[{"etaU", "/", "mu"}]}]}], ";",
      RowBox[{"xitotd", " ", "=", " ",
       RowBox[{"Lower", "[",
        RowBox[{"xitotU", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"xitotUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"xitotU", ",",
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";",
      RowBox[{"xitotUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"xitotUjd", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{
       "Einstein", " ", "charges", " ", "but", " ", "for", " ", "the", " ",
        "total", " ", "vector", " ", "xitotU"}], " ", "*)"}],
      "\[IndentingNewLine]",
      RowBox[{"Integrand1UU", " ", "=", " ",
       RowBox[{"Outer", "[",
        RowBox[{"Times", ",", "xitotU", ",",
         RowBox[{
          RowBox[{"Contract", "[",
           RowBox[{"hUUjd", ",",
            RowBox[{"{",
             RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "-", "dethjU"}]}],
        "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand2UU", " ", "=", " ",
       RowBox[{
        RowBox[{"-",
         RowBox[{"Transpose", "[",
          RowBox[{
           RowBox[{"multiDot", "[",
            RowBox[{"xitotd", ",", "hUUjU", ",",
             RowBox[{"{",
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ",",
           RowBox[{"{",
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "-",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "deth", " ",
         RowBox[{"Transpose", "[",
          RowBox[{"xitotUjU", ",",
           RowBox[{"{",
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "+", "  ",
        RowBox[{"multiDot", "[",
         RowBox[{"hUU", ",", "xitotUjd", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"KillingUd", " ", "=", " ",
       RowBox[{"xiUjd", "+",
        RowBox[{"Transpose", "[",
         RowBox[{"xidjU", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"IntegrandEUU", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], " ",
        RowBox[{"multiDot", "[",
         RowBox[{"hUU", ",", "KillingUd", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"result1", " ", "=", "  ",
       RowBox[{
        RowBox[{"Integrand1UU", "[",
         RowBox[{"[",
          RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
        RowBox[{"Integrand1UU", "[",
         RowBox[{"[",
          RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
        RowBox[{"Integrand2UU", "[",
         RowBox[{"[",
          RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
        RowBox[{"Integrand2UU", "[",
         RowBox[{"[",
          RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
        RowBox[{"IntegrandEUU", "[",
         RowBox[{"[",
          RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
        RowBox[{"IntegrandEUU", "[",
         RowBox[{"[",
          RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{
       "Contibutions", " ", "coming", " ", "only", " ", "from", " ", "TMG"}],
       " ", "*)"}], "\[IndentingNewLine]",
      RowBox[{"hddjd", " ", "=", " ",
       RowBox[{"covD", "[", "hdd", "]"}]}], ";", " ",
      RowBox[{"hddjdjd", " ", "=", " ",
       RowBox[{"covD", "[", "hddjd", "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"hddjdjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hddjdjd", ",", "4"}], "]"}]}], ";", " ",
      RowBox[{"temp1dd", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"hddjdjU", " ", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "4"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"Boxhdd", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"hddjdjU", " ", ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], ";",
      RowBox[{"dethjdjd", " ", "=", " ",
       RowBox[{"covD", "[", "dethjd", "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"linRcdd", " ", "=",
       RowBox[{
        RowBox[{"(", " ",
         RowBox[{"temp1dd", " ", "+",
          RowBox[{"Transpose", "[",
           RowBox[{"temp1dd", ",",
            RowBox[{"{",
             RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "-", "Boxhdd", "-",
          "dethjdjd"}], ")"}], "/", "2"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"linRccontr", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"gUU", ",", "linRcdd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"handR", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"hUU", ",", "Rdd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"linEindd", " ", "=", " ",
       RowBox[{"linRcdd", " ", "-",
        RowBox[{"R", "  ",
         RowBox[{"hdd", " ", "/", "2"}]}], "+",
        RowBox[{
         RowBox[{"(",
          RowBox[{"handR", " ", "-", "linRccontr"}], ")"}],
         RowBox[{"gdd", " ", "/", " ", "2"}]}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"hEUd", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"hUd", ",", "EUd", ",",
         RowBox[{"{",
          RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ";",
      RowBox[{"linEinUd", " ", "=", " ",
       RowBox[{
        RowBox[{"Raise", "[",
         RowBox[{"linEindd", ",", "1"}], "]"}], "-", "hEUd"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"linEincontr", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"linEinUd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      RowBox[{"temp1UUU", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"epsUUU", ",", "linEinUd", ",",
         RowBox[{"{",
          RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"xidualUU", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"epsUUU", ",", "xid", ",",
         RowBox[{"{",
          RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"ContribCS1UU", " ", "=", " ",
       RowBox[{
        RowBox[{"multiDot", "[",
         RowBox[{"temp1UUU", ",", "xid", ",",
          RowBox[{"{",
           RowBox[{"3", ",", "1"}], "}"}]}], "]"}], "-",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "linEincontr", " ", "xidualUU"}]}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"temp1", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"hEUd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      RowBox[{"temp2d", " ", "=", "  ",
       RowBox[{
        RowBox[{"multiDot", "[",
         RowBox[{"xid", ",", "EUd", ",",
          RowBox[{"{",
           RowBox[{"1", ",", "1"}], "}"}]}], "]"}], "+",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "R", " ", "xid"}]}]}], " ", ";",
      "\[IndentingNewLine]",
      RowBox[{"ContribCS2UU", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "temp1", " ", "xidualUU"}], " ", "+",
        RowBox[{
         RowBox[{"1", "/", "4"}], " ", "deth", " ",
         RowBox[{"multiDot", "[",
          RowBox[{"epsUUU", ",", "temp2d", ",",
           RowBox[{"{",
            RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{
        RowBox[{
        "Extra", " ", "contribution", " ", "of", " ", "the", " ", "Chern"}],
        "-",
        RowBox[{"Simons", " ", "term", " ",
         RowBox[{"(",
          RowBox[{"see", " ", "0808.1911"}], " ", ")"}]}]}], " ", "*)"}],
      "\[IndentingNewLine]",
      RowBox[{"KillingUdjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"KillingUd", ",",
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";",
      RowBox[{"temp1d", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"KillingUdjd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}], ";",
      RowBox[{"temp2d", " ", "=", " ",
       RowBox[{"Contract", "[",
        RowBox[{"KillingUdjd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"ContribCS3UU", " ", "=", " ",
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", "deth", " ",
        RowBox[{"multiDot", "[",
         RowBox[{"epsUUU", ",",
          RowBox[{"temp1d", "-", "temp2d"}], ",",
          RowBox[{"{",
           RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}]}], " ", ";",
      "\[IndentingNewLine]",
      RowBox[{"resultCS", " ", "=", " ",
       RowBox[{
        RowBox[{"ContribCS1UU", "[",
         RowBox[{"[",
          RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
        RowBox[{"ContribCS1UU", "[",
         RowBox[{"[",
          RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
        RowBox[{"ContribCS2UU", "[",
         RowBox[{"[",
          RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
        RowBox[{"ContribCS2UU", "[",
         RowBox[{"[",
          RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
        RowBox[{"(",
         RowBox[{
          RowBox[{"ContribCS3UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"ContribCS3UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]",
      RowBox[{"ChargeSuppl", " ", "=", "  ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"IntegrandEUU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"IntegrandEUU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}], " ", "-", "  ",
          RowBox[{
           RowBox[{"(",
            RowBox[{
             RowBox[{"ContribCS3UU", "[",
              RowBox[{"[",
               RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
             RowBox[{"ContribCS3UU", "[",
              RowBox[{"[",
               RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}], "/",
           "mu"}]}], ")"}]}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Charge", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ",
        RowBox[{"(",
         RowBox[{"result1", " ", "-", " ",
          RowBox[{"resultCS", "/", "mu"}]}], ")"}]}]}]}]}],
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
