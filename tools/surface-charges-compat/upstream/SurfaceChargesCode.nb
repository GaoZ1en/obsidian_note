Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinsteinAsympt", "::", "usage"}], " ", "=", " ",
   "\"\<ChargesEinsteinAsympt[xiU_,hdd_,signatureg_,{index1_,index2_},{\
coordAsympt_,LimitAsympt_}, order_] compute the surface charge asymptotically \
in Einstein gravity\nNeed = metric and coord should be defined and RGtensors \
should have been executed prior to this procedure\nInput = A Killing vector \
or asymptotic Killing vector 'xiU' \n        A metric perturbation 'hdd'\n\t  \
  The signature of the metric 'signatureg' (1 or -1)\n        A surface of \
codimension 2 specified by the two indices '{index1,index2}' in the \
coordinates coord that are fixed\n        The coordinate to expand onto \
'coordAsympt', the value of the coordinate at the limit 'LimitAsympt' and the \
number of terms wished in the final expansion 'order'\nOutput = The \
components {index1,index2} of the surface charge associated with the vector \
xiU under the perturbation\nExtra output : ChargeSuppl : supplementary term \
with respect to the Iyer-Wald formula.\nConvention : The Einstein Lagrangian \
has the form 1/(16\[Pi])Sqrt[signatureg g] R\n\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
  3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
  3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
  3.449405217921875*^9, 3.449405298078125*^9}, {3.4494055233125*^9,
  3.4494055234375*^9}, {3.45373408934375*^9,
  3.453734177015625*^9}},ExpressionUUID->"e303da3c-f454-4fef-a364-\
7d141a327fa0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinsteinAsympt", "[",
    RowBox[{"xiU_List", ",", "hdd_List", ",", "signatureg_Integer", ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"coordAsympt_", ",", "LimitAsympt_"}], "}"}], ",", " ",
     "order_Integer"}], "]"}], " ", ":=", "\[IndentingNewLine]",
   RowBox[{"ChargesEinstein", "[",
    RowBox[{"xiU", ",",
     RowBox[{"SeriesWithNTerms", "[",
      RowBox[{"hdd", ",",
       RowBox[{"{",
        RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
      "]"}], ",", "signatureg", ",",
     RowBox[{"{",
      RowBox[{"index1", ",", "index2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.447703192734375*^9, 3.447703230203125*^9}, {
