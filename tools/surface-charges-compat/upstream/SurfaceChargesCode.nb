Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KomarIntegral", "[",
    RowBox[{"xiU_List", ",", "signatureg_Integer", ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}]}], "]"}], " ",
   ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"xiUjd", ",", "xiUjU", ",", "Charge"}], "}"}], ",",
     "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "gdd", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Raise\>\"", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Lower\>\"", "]"}], "&&",
         RowBox[{"NameQ", "[", "\"\<covD\>\"", " ", "]"}], "&&",
         RowBox[{"ValueQ", "[", "gUU", "]"}], " ", "&&",
         RowBox[{"ValueQ", "[", "detg", "]"}]}], "   ", ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<RGtensors should be executed prior to this procedure.\>\"",
          "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "coord", "]"}], " ", "&&", " ",
         RowBox[{"ValueQ", "[", "metric", "]"}]}], "   ", ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<metric and coord not defined.\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
         RowBox[{"signatureg", " ", "=!=", "  ",
          RowBox[{"-", "1"}]}]}], " ", ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incoherent signature detected\>\"", "]"}], ";"}],
         ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
           "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
         RowBox[{"Dimensions", "[", "xiU", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&",
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<The surface charge is inversely proportional to Newton \
constant and should be integrated on the \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index1", "]"}], "]"}], ",", "\"\< , \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index2", "]"}], "]"}], ",",
           "\"\< = constant surface\>\""}], "]"}], ";"}],
        "\[IndentingNewLine]", ",",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<Invalid arguments for the choice of n-2 surface\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"xiUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"xiU", ",",
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";",
      RowBox[{"xiUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"xiUjd", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Charge", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], "  ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"xiUjU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"xiUjU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}]}]}],
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.43897310171875*^9, 3.43897329153125*^9}, {
