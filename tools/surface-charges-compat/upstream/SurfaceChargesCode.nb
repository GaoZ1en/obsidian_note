   3.44940439725*^9, 3.449404398265625*^9}, {3.449404513921875*^9,
   3.4494045349375*^9}, {3.4494047080625*^9, 3.449404726765625*^9}, {
   3.449405085359375*^9, 3.449405090421875*^9}, {3.449405196734375*^9,
   3.4494052085625*^9}, {3.449405406109375*^9,
   3.449405419703125*^9}},ExpressionUUID->"1b394037-d4d9-45b1-b5ea-\
f5d1a7c668b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinsteinMaxwellScalar", "::", "usage"}], " ", "=", " ",
   "\"\<ChargesEinsteinMaxwellScalar[{xiU_,\[Lambda]_},{Ad_,\[Phi]_},{hdd_,ad_\
,var\[Phi]_},signatureg_,{index1_,index2_},{kin\[Phi]_,kinA_,\[Phi]Uneval_}] \
compute the surface charge in Einstein gravity coupled to Maxwell and one \
scalar field\nNeed = metric and coord should be defined and RGtensors should \
have been executed prior to this procedure\nInput = A couple of (asymptotic) \
symmetry parameters : 'xiU' and '\[Lambda]' \n        The background gauge \
field 'Ad' and scalar fields '\[Phi]'\n        The variation of the metric \
'hdd', gauge field 'ad' and scalar field 'var\[Phi]'\n\t    The signature of \
the metric 'signatureg' (1 or -1)\n        A surface of codimension 2 \
specified by the two indices '{index1,index2}' in the coordinates coord that \
are fixed\n\t    The normalisation constants 'kinA[\[Phi]Uneval]', \
'kin\[Phi][\[Phi]Uneval]' in the Lagrangian as a function of the special \
variable '\[Phi]Uneval' \nOutput = The components {index1,index2} of the \
surface charge associated with the symmetry (xiU,\[Lambda]) under the \
perturbation\nExtra output : ChargeSuppl : supplementary term with respect to \
the Iyer-Wald formula.\nConvention : The Lagrangian has the form\n        L = \
\!\(\*FractionBox[SqrtBox[\(signatureg\\\ g\)], \(16  \[Pi]\)]\)(R - \
\!\(\*FractionBox[\(1\), \(4\)]\)kinA[\[Phi]] \!\(\*SuperscriptBox[\(F\), \(\
\[Mu]\[Nu]\)]\)\!\(\*SubscriptBox[\(F\), \(\[Mu]\[Nu]\)]\) - \
\!\(\*FractionBox[\(1\), \(2\)]\)kin\[Phi][\[Phi]]\!\(\*SubscriptBox[\(\
\[PartialD]\), \(\[Mu]\)]\)\[Phi]\!\(\*SuperscriptBox[\(\[PartialD]\), \
\(\[Mu]\)]\)\[Phi])\n\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
  3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
  3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
  3.449405217921875*^9, 3.449405298078125*^9}, {3.449405476078125*^9,
  3.44940573734375*^9}},ExpressionUUID->"7c873850-4d2e-4229-ba5a-\
62f7b318ba2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinsteinMaxwellScalar", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"xiU_List", ",", "\[Lambda]_"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"Ad_List", ",", "\[Phi]_"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"hdd_List", ",", "ad_List", ",", "var\[Phi]_"}], "}"}], ",",
     "signatureg_Integer", ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"kin\[Phi]_", ",", "kinA_", ",", "\[Phi]Uneval_Symbol"}],
      "}"}]}], "]"}], " ", ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
      "hUd", ",", "hUU", ",", "deth", ",", "xid", ",", "xiUjd", ",", "xiUjU",
       ",", "xidjU", ",", "dethjd", ",", "dethjU", ",", "hUUjd", ",", "hUUjU",
        ",", "Integrand1UU", ",", "Integrand2UU", ",", "KillingUd", ",",
       "IntegrandEUU", ",", "ChargeEinstein", ",", "dim", ",", "Fdd", ",",
       "FdU", ",", "FUU", ",", "Integrand3UU", ",", "temp", ",", "xiA", ",",
       "LieAU", ",", "aU", ",", "fdd", ",", "fUU", ",", "Integrand4UU", ",",
       "Integrand5UU", ",", "\[Phi]jd", ",", "\[Phi]jU", ",",
       "ContribMaxwell", ",", "ContribScal", ",", "DkEval", ",", "kinAEval",
       ",", "kin\[Phi]Eval"}], "}"}], ",", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "gdd", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Raise\>\"", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Lower\>\"", "]"}], "&&",
         RowBox[{"NameQ", "[", "\"\<covD\>\"", " ", "]"}], "&&",
         RowBox[{"ValueQ", "[", "gUU", "]"}], " ", "&&",
         RowBox[{"ValueQ", "[", "detg", "]"}], "  ", "&&",
         RowBox[{"NameQ", "[", "\"\<multiDot\>\"", "]"}]}], " ", ",", ",",
        " ",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<RGtensors should be executed prior to this procedure.\>\"",
          "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "coord", "]"}], " ", "&&", " ",
         RowBox[{"ValueQ", "[", "metric", "]"}]}], "   ", ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<metric and coord not defined.\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
         RowBox[{"signatureg", " ", "=!=", "  ",
          RowBox[{"-", "1"}]}]}], " ", ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incoherent signature detected\>\"", "]"}], ";"}],
         ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
           "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "hdd", "]"}], " ", "=!=", "  ",
         RowBox[{"Dimensions", "[", "metric", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], " ", "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
          RowBox[{"Dimensions", "[", "xiU", "]"}]}], " ", "&&", " ",
         RowBox[{
          RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
          RowBox[{"Dimensions", "[", "Ad", "]"}]}], "&&",
         RowBox[{
          RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
          RowBox[{"Dimensions", "[", "ad", "]"}]}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "kin\[Phi]", "]"}], " ", "=!=",
          RowBox[{"{", "}"}]}], "&&", " ",
         RowBox[{
          RowBox[{"Dimensions", "[", "kinA", "]"}], " ", "=!=",
          RowBox[{"{", "}"}]}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incoherent kinetic terms detected\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&",
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<The surface charge is inversely proportional to Newton \
constant and should be integrated on the \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index1", "]"}], "]"}], ",", "\"\< , \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index2", "]"}], "]"}], ",",
           "\"\< = constant surface\>\""}], "]"}], ";"}],
        "\[IndentingNewLine]", ",",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<Invalid arguments for the choice of n-2 surface\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"dim", " ", "=", " ",
       RowBox[{
        RowBox[{"Dimensions", "[", "coord", "]"}], "[",
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"hUd", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hdd", ",", "1"}], "]"}]}], ";",
      RowBox[{"hUU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hUd", ",", "2"}], "]"}]}], ";",
      RowBox[{"deth", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"gUU", ",", "hdd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"xid", " ", "=", " ",
       RowBox[{"Lower", "[",
        RowBox[{"xiU", ",", "1"}], "]"}]}], ";",
      RowBox[{"xiUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"xiU", ",",
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";",
      RowBox[{"xiUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"xiUjd", ",", "2"}], "]"}]}], ";",
      RowBox[{"xidjU", " ", "=", " ",
       RowBox[{"Lower", "[",
        RowBox[{"xiUjU", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"dethjd", " ", "=", " ",
       RowBox[{"covD", "[", "deth", "]"}]}], ";",
      RowBox[{"dethjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"dethjd", ",", "1"}], "]"}]}], ";",
      RowBox[{"hUUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"hUU", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      RowBox[{"hUUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hUUjd", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand1UU", " ", "=", " ",
       RowBox[{"Outer", "[",
        RowBox[{"Times", ",", "xiU", ",",
         RowBox[{
          RowBox[{"Contract", "[",
           RowBox[{"hUUjd", ",",
            RowBox[{"{",
             RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "-", "dethjU"}]}],
        "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand2UU", " ", "=", " ",
       RowBox[{
        RowBox[{"-",
         RowBox[{"Transpose", "[",
          RowBox[{
           RowBox[{"multiDot", "[",
            RowBox[{"xid", ",", "hUUjU", ",",
             RowBox[{"{",
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ",",
           RowBox[{"{",
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "-",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "deth", " ",
         RowBox[{"Transpose", "[",
          RowBox[{"xiUjU", ",",
           RowBox[{"{",
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "+", " ",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ",
         RowBox[{"multiDot", "[",
          RowBox[{"hUU", ",",
           RowBox[{"xiUjd", "-",
            RowBox[{"Transpose", "[",
             RowBox[{"xidjU", ",",
              RowBox[{"{",
               RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ",",
           RowBox[{"{",
            RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"KillingUd", " ", "=", " ",
       RowBox[{"xiUjd", "+",
        RowBox[{"Transpose", "[",
         RowBox[{"xidjU", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"IntegrandEUU", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], " ",
        RowBox[{"multiDot", "[",
         RowBox[{"hUU", ",", "KillingUd", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"ChargeEinstein", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ", " ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"Integrand1UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand1UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
          RowBox[{"Integrand2UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand2UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{"Maxwell", " ", "Part"}], " ", "*)"}], "\[IndentingNewLine]",
      RowBox[{"Fdd", " ", "=", " ",
       RowBox[{"Table", "[",
        RowBox[{
         RowBox[{"Table", "[",
          RowBox[{
           RowBox[{
            RowBox[{"D", "[",
             RowBox[{
              RowBox[{"Ad", "[",
               RowBox[{"[", "i", "]"}], "]"}], ",",
              RowBox[{"coord", "[",
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "-",
            RowBox[{"D", "[",
             RowBox[{
              RowBox[{"Ad", "[",
               RowBox[{"[", "j", "]"}], "]"}], ",",
              RowBox[{"coord", "[",
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], " ", ",",
           RowBox[{"{",
            RowBox[{"i", ",", "1", ",", " ", "dim"}], "}"}]}], "]"}], ",",
         RowBox[{"{",
          RowBox[{"j", ",", "1", ",", "dim"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"FdU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"Fdd", ",", "2"}], "]"}]}], ";",
      RowBox[{"FUU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"FdU", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"DkEval", " ", "=", " ",
       RowBox[{
        RowBox[{"D", "[",
         RowBox[{"kinA", ",", "\[Phi]Uneval"}], "]"}], " ", "/.", " ",
        RowBox[{"{",
         RowBox[{"\[Phi]Uneval", " ", "\[Rule]", " ", "\[Phi]"}], "}"}]}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"kinAEval", " ", "=", " ",
       RowBox[{"kinA", "/.", " ",
        RowBox[{"{",
         RowBox[{"\[Phi]Uneval", " ", "\[Rule]", " ", "\[Phi]"}], "}"}]}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"kin\[Phi]Eval", " ", "=", " ",
       RowBox[{"kin\[Phi]", " ", "/.", " ",
        RowBox[{"{",
         RowBox[{"\[Phi]Uneval", " ", "\[Rule]", " ", "\[Phi]"}], "}"}]}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"Integrand3UU", "=", " ",
       RowBox[{"kinAEval", " ",
        RowBox[{"Outer", "[",
         RowBox[{"Times", ",", "xiU", ",",
          RowBox[{"multiDot", "[",
           RowBox[{"FUU", ",", "ad", ",",
            RowBox[{"{",
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"temp", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"hUU", ",", "FdU", ",",
         RowBox[{"{",
          RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"xiA", " ", "=", " ",
       RowBox[{
        RowBox[{"xiU", " ", ".", " ", "Ad"}], " ", "+", " ", "\[Lambda]"}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"LieAU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{
         RowBox[{
          RowBox[{"multiDot", "[",
           RowBox[{"xiU", ",", "Fdd", ",",
            RowBox[{"{",
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}], "+",
          RowBox[{"Table", "[",
           RowBox[{
            RowBox[{"D", "[",
             RowBox[{"xiA", ",",
              RowBox[{"coord", "[",
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", ",",
            RowBox[{"{",
             RowBox[{"i", ",", "1", ",", " ", "dim"}], "}"}]}], "]"}]}], ",",
         "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"fdd", " ", "=", " ",
       RowBox[{"Table", "[",
        RowBox[{
         RowBox[{"Table", "[",
          RowBox[{
           RowBox[{
            RowBox[{"D", "[",
             RowBox[{
              RowBox[{"ad", "[",
               RowBox[{"[", "i", "]"}], "]"}], ",",
              RowBox[{"coord", "[",
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "-",
            RowBox[{"D", "[",
             RowBox[{
              RowBox[{"ad", "[",
               RowBox[{"[", "j", "]"}], "]"}], ",",
              RowBox[{"coord", "[",
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], " ", ",",
           RowBox[{"{",
            RowBox[{"i", ",", "1", ",", " ", "dim"}], "}"}]}], "]"}], ",",
         RowBox[{"{",
          RowBox[{"j", ",", "1", ",", "dim"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"fUU", " ", "=", "  ",
       RowBox[{"Raise", "[",
        RowBox[{"fdd", ",", "1", ",", "2"}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"aU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"ad", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand4UU", "=", " ",
       RowBox[{
        RowBox[{"kinAEval",
         RowBox[{"(",
          RowBox[{
           RowBox[{
            RowBox[{"(",
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"-", "1"}], "/", "4"}], " ", "deth", " ", "xiA"}],
              " ", "-",
              RowBox[{
               RowBox[{"1", "/", "2"}],
               RowBox[{"(",
                RowBox[{"xiU", " ", ".", " ", "ad"}], ")"}]}]}], " ", ")"}],
            "FUU"}], " ", "+", "  ",
           RowBox[{"xiA", " ", "temp"}], " ", "-",
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", "xiA", " ", "fUU"}]}], ")"}]}], " ",
         "-", " ",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "xiA", " ", "DkEval", "  ",
         "var\[Phi]", "  ", "FUU"}]}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand5UU", "=",
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], " ", "kinAEval", " ",
        RowBox[{"Outer", "[",
         RowBox[{"Times", ",", "aU", ",", "LieAU"}], "]"}]}]}], " ", ";",
      "\[IndentingNewLine]",
      RowBox[{"ContribMaxwell", "=",
       RowBox[{
        RowBox[{"1", "/",
         RowBox[{"(",
          RowBox[{"16", " ", "Pi"}], ")"}]}],
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"Integrand3UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand3UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+", " ",
          RowBox[{"Integrand4UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-", " ",
          RowBox[{"Integrand4UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
          RowBox[{"Integrand5UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand5UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]",
      RowBox[{"(*", " ",
       RowBox[{"Scalar", " ", "Part"}], " ", "*)"}], "\[IndentingNewLine]",
      RowBox[{"\[Phi]jd", " ", "=", " ",
       RowBox[{"Table", "[",
        RowBox[{
         RowBox[{"D", "[",
          RowBox[{"\[Phi]", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", ",",
         RowBox[{"{",
          RowBox[{"i", ",", "1", ",", " ", "dim"}], "}"}]}], "]"}]}], ";",
      RowBox[{"\[Phi]jU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"\[Phi]jd", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"ContribScal", "=",
       RowBox[{
        RowBox[{
         RowBox[{"-", "kin\[Phi]Eval"}], " ", "/",
         RowBox[{"(",
          RowBox[{"16", " ", "Pi"}], ")"}]}],
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], "var\[Phi]",
        RowBox[{"(",
         RowBox[{
          RowBox[{
           RowBox[{"xiU", "[",
            RowBox[{"[", "index1", "]"}], "]"}], " ",
           RowBox[{"\[Phi]jU", "[",
            RowBox[{"[", "index2", "]"}], "]"}]}], "-",
          RowBox[{
           RowBox[{"xiU", "[",
            RowBox[{"[", "index2", "]"}], "]"}], " ",
           RowBox[{"\[Phi]jU", "[",
            RowBox[{"[", "index1", "]"}], "]"}]}]}], ")"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"(*", " ", "Result", "*)"}], "\[IndentingNewLine]",
      RowBox[{"ChargeSuppl", " ", "=", "  ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"IntegrandEUU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"IntegrandEUU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
          RowBox[{"Integrand5UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand5UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]",
      RowBox[{"Charge", " ", "=", " ",
       RowBox[{
       "ChargeEinstein", " ", "+", " ", "ContribMaxwell", "+", "  ",
        "ContribScal"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
