Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargespForm", "::", "usage"}], " ", "=", " ",
   "\"\<ChargespForm[{xiU_,\[Lambda]_},{Addotsd_,\[Phi]_},{hdd_,addotsd_,var\
\[Phi]_},signatureg_,{index1_,index2_},{kinA_,\[Phi]Uneval_}] compute the \
surface charge of the p-form action\nNeed = metric and coord should be \
defined and RGtensors should have been executed prior to this procedure\n\
Input = A couple of (asymptotic) symmetry parameters : 'xiU' and '\[Lambda]' \
\n        The background gauge field 'Addotsd' and scalar fields '\[Phi]'\n   \
     The variation of the metric 'hdd', gauge field 'addotsd' and scalar \
field 'var\[Phi]'\n\t    The signature of the metric 'signatureg' (1 or -1)\n \
       A surface of codimension 2 specified by the two indices \
'{index1,index2}' in the coordinates coord that are fixed\n\t    The \
normalisation constants 'kinA[\[Phi]Uneval]' in the Lagrangian as a function \
of the special variable '\[Phi]Uneval' \nOutput = The components \
{index1,index2} of the surface charge associated with the symmetry (xiU,\
\[Lambda]) under the perturbation\nExtra output : ChargeSuppl : supplementary \
term with respect to the Iyer-Wald formula.\nConvention : The Lagrangian has \
the form\n        L = \!\(\*FractionBox[SqrtBox[\(signatureg\\\ g\)], \(16  \
\[Pi]\)]\)( - \!\(\*FractionBox[\(1\), \(2\\\ \(\((p + \
1)\)!\)\)]\)kinA[\[Phi]] \!\(\*SuperscriptBox[\(F\), \(\(\*SubscriptBox[\(\
\[Mu]\), \(1\)] .. \) \*SubscriptBox[\(\[Mu]\), \(p + \
1\)]\)]\)\!\(\*SubscriptBox[\(F\), \(\(\*SubscriptBox[\(\[Mu]\), \(1\)] ... \
\) \*SubscriptBox[\(\[Mu]\), \(p + 1\)]\)]\) )\n\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
  3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
  3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
  3.449405217921875*^9, 3.449405298078125*^9}, {3.449405476078125*^9,
  3.44940573734375*^9}, {3.449408181359375*^9, 3.449408181671875*^9}, {
  3.449408227046875*^9, 3.449408242046875*^9}, {3.45374231659375*^9,
  3.45374237603125*^9}},ExpressionUUID->"b333f606-0ec2-4409-a8c8-\
7761bfbcdddd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargespForm", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"xiU_List", ",", "\[Lambda]_"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"Addotsd_List", ",", "\[Phi]_"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"hdd_List", ",", "addotsd_List", ",", "var\[Phi]_"}], "}"}],
     ",", "signatureg_Integer", ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"kinA_", ",", "\[Phi]Uneval_Symbol"}], "}"}]}], "]"}], " ", ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
      "hUd", ",", "hUU", ",", "deth", ",", "p", ",", "dim", ",", "perm", ",",
       "permp", ",", "dAddotsd", ",", "Fddotsd", ",", "FUdotsU", ",",
       "Integrand3UU", ",", "temp", ",", "xiAddotd", ",", "xiaddotd", ",",
       "FxiAUU", ",", "FxiaUU", ",", "hFxiAUU", ",", "hFUdotsU", ",",
       "xiAhHUU", ",", "preLie", " ", ",", "LieAddotsd", " ", ",",
       "LieAUdotsU", ",", "daddotsd", ",", "fddotsd", ",", "fUdotsU", ",",
       "fxiAUU", ",", "aUdotsd", ",", "Integrand4UU", ",", "Integrand5UU",
       ",", " ", "ContribpForm", ",", "DkEval", ",", "kinAEval"}], "}"}], ",",
      "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "hdd", "]"}], " ", "=!=", "  ",
         RowBox[{"Dimensions", "[", "gdd", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Incompatible dimensions detected\>\"", "]"}], ";",
         RowBox[{"Return", "[", "]"}], ";"}]}], " ", "]"}], ";",
      "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
         RowBox[{"Dimensions", "[", "xiU", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Incompatible dimensions detected\>\"", "]"}], ";",
         RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";",
      "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
         RowBox[{"signatureg", " ", "=!=", "  ",
          RowBox[{"-", "1"}]}]}], " ", ",",
        RowBox[{
         RowBox[{"Print", "[", "\"\<Incoherent signature detected\>\"", "]"}],
          ";",
         RowBox[{"Return", "[", "]"}], ";"}], ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
           "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "index1", "]"}], " ", "&&", "  ",
         RowBox[{"IntegerQ", "[", "index2", "]"}]}], ",",
        "\[IndentingNewLine]",
        RowBox[{"If", "[",
         RowBox[{
          RowBox[{
           RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
            RowBox[{
             RowBox[{"Dimensions", "[", "coord", "]"}], "[",
             RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&",
           RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
            RowBox[{
             RowBox[{"Dimensions", "[", "coord", "]"}], "[",
             RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ",
          RowBox[{
           RowBox[{"Print", "[",
            RowBox[{
            "\"\<The final answer is inversely proportional to Newton \
constant and should be integrated on the \>\"", ",",
             RowBox[{"coord", "[",
              RowBox[{"[", "index1", "]"}], "]"}], ",", "\"\< , \>\"", ",",
             RowBox[{"coord", "[",
              RowBox[{"[", "index2", "]"}], "]"}], ",",
             "\"\< = constant surface\>\""}], "]"}], ";"}],
          "\[IndentingNewLine]", ",",
          RowBox[{
           RowBox[{
           "Print", "[",
            "\"\<Incompatible dimensions detected in the indices\>\"", "]"}],
           ";",
           RowBox[{"Return", "[", "]"}], ";"}]}], "\[IndentingNewLine]",
         "]"}], "\[IndentingNewLine]", ",",
        RowBox[{
         RowBox[{
         "Print", "[",
          "\"\<Non-integer arguments for the choice of n-2 surface\>\"",
          "]"}], ";",
