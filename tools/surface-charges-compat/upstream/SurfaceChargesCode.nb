  3.453734374859375*^9,
  3.453734377765625*^9}},ExpressionUUID->"22e6c29f-0297-404d-bcb4-\
a90e20ee6fa2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinsteinMaxwellScalarAsympt", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"xiU_List", ",", "\[Lambda]_"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"Ad_List", ",", "\[Phi]_"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"hdd_List", ",", "ad_List", ",", "var\[Phi]_"}], "}"}], ",",
     "signatureg_Integer", ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"kin\[Phi]_", ",", "kinA_", ",", "\[Phi]Uneval_Symbol"}], "}"}],
      ",",
     RowBox[{"{",
      RowBox[{"coordAsympt_", ",", "LimitAsympt_"}], "}"}], ",", " ",
     "order_Integer"}], "]"}], " ", ":=",
   RowBox[{"ChargesEinsteinMaxwellScalar", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"xiU", ",", "\[Lambda]"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"SeriesWithNTerms", "[",
