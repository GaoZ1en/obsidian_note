       "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{
     "Print", "[", "\"\<epsUUU,epsddd,CotUd,Cotdd have been computed.\>\"",
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
