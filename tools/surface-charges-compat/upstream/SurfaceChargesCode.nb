Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Liediffdd", "::", "usage"}], " ", "=",
   "\"\<Liediffdd[gdd_,coord_,xiU_] : Lie differential of tensor with two \
covariant indices \[IndentingNewLine]Input: the Lie vector field xiU, a \
tensor gdd and the list of coordinates coord \[IndentingNewLine]Output: the \
Lie derivative of gdd with respect to xiU\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.448813779328125*^9, 3.4488138383125*^9},
   3.448814018703125*^9},ExpressionUUID->"523010ae-5a79-4d85-9f3f-\
28fc19c578e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Liediffdd", "[",
   RowBox[{"gdd_List", ",", "coord_List", ",", "xiU_List"}], "]"}], " ", ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
     "temp00", ",", "indrho", ",", "indmu", ",", "indnu", ",", "dimmetric"}],
     "}"}], ",", "\[IndentingNewLine]",
    RowBox[{
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[",
         RowBox[{"Dimensions", "[", "gdd", "]"}], "]"}], "\[Equal]", "2"}],
       ",", ",",
       RowBox[{
        RowBox[{"Return", "[", "\"\<Invalid arguments\>\"", "]"}], ";"}]}],
      "]"}], ";", "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "gdd", "]"}], "[",
          RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", " ",
         RowBox[{"Dimensions", "[", "coord", "]"}]}], "&&",
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "gdd", "]"}], "[",
          RowBox[{"[", "2", "]"}], "]"}], "\[Equal]", " ",
         RowBox[{"Dimensions", "[", "coord", "]"}]}], "&&",
        RowBox[{
         RowBox[{"Dimensions", "[", "xiU", "]"}], "\[Equal]", " ",
         RowBox[{"Dimensions", "[", "coord", "]"}]}]}], ",", ",",
       RowBox[{
        RowBox[{
        "Return", "[", "\"\<Incompatible dimensions among the arguments\>\"",
         "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
     RowBox[{"dimmetric", " ", "=", " ",
      RowBox[{"Length", "[", "coord", "]"}]}], ";", "  ",
     RowBox[{"Table", "[", "\[IndentingNewLine]",
      RowBox[{
       RowBox[{
        RowBox[{"temp00", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]",
        RowBox[{"For", "[",
         RowBox[{
          RowBox[{"indrho", "=", "1"}], ",",
          RowBox[{"indrho", "\[LessEqual]", "dimmetric"}], ",", " ",
          RowBox[{"indrho", "++"}], ",", "\[IndentingNewLine]",
          RowBox[{
           RowBox[{"temp00", " ", "=",
            RowBox[{"temp00", " ", "+", " ",
             RowBox[{
              RowBox[{"D", "[",
               RowBox[{
                RowBox[{"gdd", "[",
                 RowBox[{"[",
                  RowBox[{"indmu", ",", "indnu"}], "]"}], "]"}], ",",
                RowBox[{"coord", "[",
                 RowBox[{"[", "indrho", "]"}], "]"}]}], "]"}],
              RowBox[{"xiU", "[",
               RowBox[{"[", "indrho", "]"}], "]"}]}], "+",
             RowBox[{
              RowBox[{"D", "[",
               RowBox[{
                RowBox[{"xiU", "[",
                 RowBox[{"[", "indrho", "]"}], "]"}], ",",
                RowBox[{"coord", "[",
                 RowBox[{"[", "indmu", "]"}], "]"}]}], "]"}], " ",
              RowBox[{"gdd", "[",
               RowBox[{"[",
                RowBox[{"indrho", ",", "indnu"}], "]"}], "]"}]}], "+",
             RowBox[{
              RowBox[{"D", "[",
               RowBox[{
                RowBox[{"xiU", "[",
                 RowBox[{"[", "indrho", "]"}], "]"}], ",",
                RowBox[{"coord", "[",
                 RowBox[{"[", "indnu", "]"}], "]"}]}], "]"}], " ",
              RowBox[{"gdd", "[",
               RowBox[{"[",
                RowBox[{"indmu", ",", "indrho"}], "]"}], "]"}]}]}]}], " ",
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", " ", "temp00"}], ",",
       RowBox[{"{",
        RowBox[{"indmu", ",", "dimmetric"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"indnu", ",", "dimmetric"}], "}"}]}], "]"}]}]}], " ",
   "]"}]}]], "Input",
 CellChangeTimes->{{3.4488137343125*^9, 3.44881376090625*^9}, {
   3.4488138489375*^9, 3.448814009625*^9}, {3.449077851859375*^9,
   3.44907786225*^9},
   3.4490779504375*^9},ExpressionUUID->"d657b3f8-7993-4bbc-bc2c-599c0b2645d0"],

