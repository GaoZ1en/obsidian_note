Cell[BoxData[
 RowBox[{
  RowBox[{"Commutator", "[",
   RowBox[{"v1_", ",", "v2_"}], "]"}], " ", ":=", " ",
  RowBox[{
   RowBox[{"LiediffU", "[",
    RowBox[{"v2", ",", "coord", ",", "v1"}], "]"}], "/;",
   RowBox[{"(",
    RowBox[{
     RowBox[{"ValueQ", "[", "coord", "]"}], "&&", " ",
     RowBox[{
      RowBox[{"Dimensions", "[", "coord", "]"}], "\[Equal]",
      RowBox[{"Dimensions", "[", "v1", "]"}]}], "&&", " ",
     RowBox[{
      RowBox[{"Dimensions", "[", "coord", "]"}], "\[Equal]",
      RowBox[{"Dimensions", "[", "v2", "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.450047783515625*^9, 3.450047835671875*^9}, {
  3.450047919546875*^9, 3.450047933921875*^9}, {3.453743163515625*^9,
