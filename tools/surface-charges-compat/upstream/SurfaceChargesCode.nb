Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CottonAsympt", "::", "usage"}], " ", "=",
   "\"\<CottonAsympt[signatureg_,{coordAsympt_,LimitAsympt_}, order_] : \
Asymptotic form of the Cotton tensor of a 3d metric\nNeeded : RGTensors \
executed on that metric\nInput: Signature (+1 or -1) of the metric,\n       \
The coordinate to expand onto, the value of the coordinate at the limit and \
the number of terms wished in the final expansion \nOutput: CotUd and Cotdd \
and the epsilon tensors : epsddd, epsUUU \nConvention : epsUUU[[1,2,3]] = + 1 \
/ Sqrt[Abs[detg]]\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449077651859375*^9, 3.449077661015625*^9}, {
   3.449077722109375*^9, 3.449077840984375*^9}, {3.453733982015625*^9,
   3.453734055484375*^9},
   3.453734096890625*^9},ExpressionUUID->"5b94d67a-9b56-487b-9616-\
b9a6fbed2a55"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CottonAsympt", "[",
   RowBox[{"signatureg_Integer", ",",
    RowBox[{"{",
     RowBox[{"coordAsympt_", ",", "LimitAsympt_"}], "}"}], ",", " ",
    "order_Integer"}], "]"}], " ", ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"g2dd", ",", "g2ddjd"}], "}"}], ",", "\[IndentingNewLine]",
    RowBox[{
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"ValueQ", "[", "gdd", "]"}], " ", "&&", " ",
        RowBox[{"ValueQ", "[", "Rdd", "]"}], " ", "&&", " ",
        RowBox[{"ValueQ", "[", "R", "]"}], " ", "&&",
        RowBox[{"ValueQ", "[", "detg", "]"}]}], ",", ",",
       RowBox[{
        RowBox[{
        "Print", "[",
         "\"\<RGtensors should be executed prior to this procedure.\>\"",
         "]"}], ";", " ",
        RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";",
     "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"Dimensions", "[", "gdd", "]"}], " ", "=!=", " ",
        RowBox[{"{",
         RowBox[{"3", ",", "3"}], "}"}]}], ",",
       RowBox[{
        RowBox[{
        "Print", "[",
         "\"\<The Cotton tensor exists only in 3 dimensions. Incoherent \
dimensions detected.\>\"", "]"}], ";", " ",
        RowBox[{"Return", "[", "]"}], ";"}]}], " ", "]"}], ";",
     "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"ValueQ", "[", "epsUUU", "]"}], " ", "||", " ",
        RowBox[{"ValueQ", "[", "epsddd", "]"}], " ", "||", " ",
        RowBox[{"ValueQ", "[", "CotUd", "]"}], " ", "||", " ",
        RowBox[{"ValueQ", "[", "Cotdd", "]"}]}], " ", ",",
       RowBox[{
        RowBox[{
        "Print", "[",
         "\"\<Variables epsUUU, epsddd, CotUd, Cotdd already assigned. They \
will be updated.\>\"", "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
     RowBox[{"If", "[",
      RowBox[{
       RowBox[{
        RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
        RowBox[{"signatureg", " ", "=!=", "  ",
         RowBox[{"-", "1"}]}]}], " ", ",",
       RowBox[{
        RowBox[{"Return", "[", "\"\<Incoherent signature detected\>\"", "]"}],
         ";"}], ",", " ",
       RowBox[{
        RowBox[{"Print", "[",
         RowBox[{
         "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
          "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
     RowBox[{"g2dd", " ", "=", " ",
      RowBox[{"SeriesWithNTerms", "[",
       RowBox[{
        RowBox[{"Rdd", "-",
         RowBox[{
          RowBox[{"1", "/", "4"}], " ", "gdd", " ", "R"}]}], " ", ",",
        RowBox[{"{",
         RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
       "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{"epsUUU", " ", "=", " ",
      RowBox[{
       RowBox[{"1", "/", " ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}]}], " ",
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",",
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",",
             RowBox[{"-", "1"}]}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{
             RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}]}],
     ";", "\[IndentingNewLine]",
     RowBox[{"epsddd", " ", "=", " ",
      RowBox[{"signatureg", " ",
       RowBox[{"Sqrt", "[",
        RowBox[{"signatureg", " ", "detg"}], "]"}], " ",
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",",
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",",
             RowBox[{"-", "1"}]}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"{",
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{
             RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",",
           RowBox[{"{",
            RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}]}],
     ";", "\[IndentingNewLine]",
     RowBox[{"g2ddjd", " ", "=",
      RowBox[{"SeriesWithNTerms", "[", " ",
       RowBox[{
        RowBox[{"covD", "[", "g2dd", "]"}], ",",
        RowBox[{"{",
         RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
       "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{"CotUd", " ", "=",
      RowBox[{"SeriesWithNTerms", "[", " ",
       RowBox[{
        RowBox[{"multiDot", "[",
         RowBox[{"epsUUU", ",", "g2ddjd", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "3"}], "}"}], ",",
          RowBox[{"{",
           RowBox[{"3", ",", "1"}], "}"}]}], "]"}], ",",
        RowBox[{"{",
         RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
       "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{"Cotdd", " ", "=",
      RowBox[{"SeriesWithNTerms", "[",
       RowBox[{
        RowBox[{"Lower", "[",
         RowBox[{"CotUd", ",", "1"}], "]"}], ",",
        RowBox[{"{",
