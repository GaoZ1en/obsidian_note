   3.4422598475058885`*^9, 3.4422598851948357`*^9}, {3.442259931430986*^9,
   3.442259944322106*^9}, {3.4422609741068277`*^9, 3.4422610372963495`*^9}, {
   3.443313522659236*^9, 3.443313647422076*^9}, {3.443313684461484*^9,
   3.443313688823172*^9}, {3.4434525895135603`*^9, 3.443452601359004*^9}, {
   3.443452890715166*^9, 3.443452894769157*^9}, {3.453645864234375*^9,
   3.453645864828125*^9}, {3.453743260140625*^9, 3.45374326171875*^9}, {
