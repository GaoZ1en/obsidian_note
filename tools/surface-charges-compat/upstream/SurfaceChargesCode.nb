Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargespFormAsympt", "::", "usage"}], " ", "=", " ",
   "\"\<ChargespFormAsympt[{xiU_,\[Lambda]_},{Addotsd_,\[Phi]_},{hdd_,addotsd_\
,var\[Phi]_},signatureg_,{index1_,index2_},{kinA_,\[Phi]Uneval_},{coordAsympt_\
,LimitAsympt_}, order_] compute the asymptotic form of the surface charge of \
the p-form action\nNeed = metric and coord should be defined and RGtensors \
should have been executed prior to this procedure\nInput = A couple of \
(asymptotic) symmetry parameters : 'xiU' and '\[Lambda]' \n        The \
background gauge field 'Addotsd' and scalar fields '\[Phi]'\n        The \
variation of the metric 'hdd', gauge field 'addotsd' and scalar field 'var\
\[Phi]'\n\t    The signature of the metric 'signatureg' (1 or -1)\n        A \
surface of codimension 2 specified by the two indices '{index1,index2}' in \
the coordinates coord that are fixed\n\t    The normalisation constants \
'kinA[\[Phi]Uneval]' in the Lagrangian as a function of the special variable \
'\[Phi]Uneval'\n        The coordinate to expand onto 'coordAsympt', the \
value of the coordinate at the limit 'LimitAsympt' and the number of terms \
wished in the final expansion 'order'  \nOutput = The components \
{index1,index2} of the surface charge associated with the symmetry (xiU,\
\[Lambda]) under the perturbation\nExtra output : ChargeSuppl : supplementary \
term with respect to the Iyer-Wald formula.\nConvention : The Lagrangian has \
the form\n        L = \!\(\*FractionBox[SqrtBox[\(signatureg\\\ g\)], \(16  \
\[Pi]\)]\)( - \!\(\*FractionBox[\(1\), \(2\\\ \(\((p + \
1)\)!\)\)]\)kinA[\[Phi]] \!\(\*SuperscriptBox[\(F\), \(\(\*SubscriptBox[\(\
\[Mu]\), \(1\)] .. \) \*SubscriptBox[\(\[Mu]\), \(p + \
1\)]\)]\)\!\(\*SubscriptBox[\(F\), \(\(\*SubscriptBox[\(\[Mu]\), \(1\)] ... \
\) \*SubscriptBox[\(\[Mu]\), \(p + 1\)]\)]\) )\n\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
  3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
  3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
  3.449405217921875*^9, 3.449405298078125*^9}, {3.449405476078125*^9,
  3.44940573734375*^9}, {3.449408181359375*^9, 3.449408181671875*^9}, {
  3.449408227046875*^9, 3.449408242046875*^9}, {3.45374231659375*^9,
  3.45374237603125*^9}, {3.453742442046875*^9, 3.4537424605*^9}, {
  3.453742517359375*^9,
  3.453742522609375*^9}},ExpressionUUID->"ad14ff5f-dccb-43da-b9be-\
106706a5ee70"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ChargespFormAsympt", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"xiU_List", ",", "\[Lambda]_"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"Addotsd_List", ",", "\[Phi]_"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"hdd_List", ",", "addotsd_List", ",", "var\[Phi]_"}], "}"}],
      ",", "signatureg_Integer", ",",
      RowBox[{"{",
       RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"kinA_", ",", "\[Phi]Uneval_Symbol"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"coordAsympt_", ",", "LimitAsympt_"}], "}"}], ",", " ",
      "order_Integer"}], "]"}], " ", ":=",
    RowBox[{"ChargespForm", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"xiU", ",", "\[Lambda]"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{
        RowBox[{"SeriesWithNTerms", "[",
         RowBox[{"Addotsd", ",",
          RowBox[{"{",
           RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
          "]"}], ",",
        RowBox[{"SeriesWithNTerms", "[",
         RowBox[{"\[Phi]", ",",
          RowBox[{"{",
           RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
          "]"}]}], "}"}], ",",
      RowBox[{"{",
       RowBox[{
        RowBox[{"SeriesWithNTerms", "[",
         RowBox[{"hdd", ",",
          RowBox[{"{",
           RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
          "]"}], ",",
        RowBox[{"SeriesWithNTerms", "[",
         RowBox[{"addotsd", ",",
          RowBox[{"{",
           RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
          "]"}], ",",
        RowBox[{"SeriesWithNTerms", "[",
         RowBox[{"var\[Phi]", ",",
          RowBox[{"{",
           RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
          "]"}]}], "}"}], ",", "signatureg", ",",
      RowBox[{"{",
       RowBox[{"index1", ",", "index2"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"kinA", ",", "\[Phi]Uneval"}], "}"}]}], "]"}]}], ";"}],
  " "}]], "Input",
 CellChangeTimes->{{3.447451312336934*^9, 3.447451340821309*^9}, {
