Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeriesWithNTerms", "::", "usage"}], " ", "=", " ",
   "\"\<SeriesWithNTerms[expr_,{coordAsympt_,LimitAsympt_},NumberTerms_]  : \
Develop in series up to a fixed number of terms \[IndentingNewLine]Input: the \
expression to be developed expr which can also be an array\n           The \
coordinate to expand onto and the value of the coordinate at the limit  \n    \
       The number of terms wished\[IndentingNewLine]Output: the series \
expansion\>\""}], ";"}]], "Input",
 CellChangeTimes->{
  3.448598207171875*^9, 3.44859825659375*^9, {3.448598287515625*^9,
   3.448598320859375*^9}, 3.44881362834375*^9, {3.448813695359375*^9,
   3.4488136965*^9}, 3.449215105765625*^9, {3.45004772878125*^9,
   3.450047747703125*^9}, {3.453732688359375*^9, 3.453732768265625*^9}, {
   3.453733784671875*^9, 3.453733917765625*^9}, {3.45403061509375*^9,
   3.4540306274375*^9}},ExpressionUUID->"8d97a113-6459-49c4-b323-\
589d66d9e4c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeriesWithNTerms", "[",
    RowBox[{"expr_", ",",
     RowBox[{"{",
      RowBox[{"coordAsympt_", ",", "LimitAsympt_"}], "}"}], ",",
     "NumberTerms_Integer"}], "]"}], " ", ":=", " ", "\[IndentingNewLine]",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"temp", ",", "result"}], "}"}], ",", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"NumberTerms", " ", "===", " ", "Null"}], " ", "||", " ",
         RowBox[{"coordAsympt", " ", "===", " ", "Null"}], " ", "||", " ",
         RowBox[{"LimitAsympt", " ", "===", " ", "Null"}]}], ",",
        RowBox[{
         RowBox[{"Print", "[", "\"\<Missing arguments\>\"", "]"}], ";", " ",
         RowBox[{"Return", "[", "expr", "]"}]}]}], "]"}], ";",
      "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{"ListQ", "[", "expr", "]"}], ",",
        RowBox[{
         RowBox[{
          RowBox[{"SeriesWithNTerms", "[",
           RowBox[{"#", ",",
            RowBox[{"{",
             RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",",
            "NumberTerms"}], "]"}], "&"}], "/@", " ", "expr"}], ",",
        "\[IndentingNewLine]",
        RowBox[{
         RowBox[{"temp", " ", "=", " ",
          RowBox[{"Series", "[",
           RowBox[{"expr", ",",
            RowBox[{"{",
             RowBox[{"coordAsympt", ",", "LimitAsympt", ",",
              RowBox[{"-", "1000"}]}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]",
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "temp", "]"}], " ", "\[GreaterEqual]", " ",
             "6"}], ",",
           RowBox[{"If", "[",
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Part", "[",
                RowBox[{"temp", ",", "1"}], "]"}], " ", "===", " ",
               "coordAsympt"}], " ", "&&", " ",
              RowBox[{
               RowBox[{"Part", "[",
                RowBox[{"temp", ",", "2"}], "]"}], " ", "===", " ",
               "LimitAsympt"}]}], ",",
             RowBox[{"result", " ", "=", " ",
              RowBox[{"Series", "[",
               RowBox[{"expr", ",",
                RowBox[{"{",
                 RowBox[{"coordAsympt", ",", "LimitAsympt", ",",
                  RowBox[{
                   RowBox[{"Ceiling", "[",
                    RowBox[{
                    RowBox[{"temp", "[",
                    RowBox[{"[", "4", "]"}], "]"}], "/",
                    RowBox[{"temp", "[",
                    RowBox[{"[", "6", "]"}], "]"}]}], "]"}], "+",
                   "NumberTerms", "-", "1"}]}], "}"}]}], "]"}]}], ",", " ",
             RowBox[{"result", "=", "expr"}]}], "]"}], ",",
           RowBox[{"result", " ", "=", " ", "expr"}]}], "]"}], ";",
         "result"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.442160943921875*^9, 3.442161138609375*^9}, {
   3.442161217453125*^9, 3.442161222734375*^9}, {3.44216142459375*^9,
