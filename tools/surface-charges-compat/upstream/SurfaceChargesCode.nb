Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LiediffU", "::", "usage"}], " ", "=", " ",
   "\"\<LiediffU[vector2_,coord_,vector_] : Lie differential of vectors \
\[IndentingNewLine]Input: two vector fields vector and vector2 and the list \
of coordinates coord \[IndentingNewLine]Output: the commutator \
[vector,vector2]\>\""}], ";"}]], "Input",
 CellChangeTimes->{
  3.448598207171875*^9, 3.44859825659375*^9, {3.448598287515625*^9,
   3.448598320859375*^9}, 3.44881362834375*^9, {3.448813695359375*^9,
   3.4488136965*^9}, 3.449215105765625*^9, {3.45004772878125*^9,
