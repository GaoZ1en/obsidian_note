        RowBox[{"\[Phi]", ",",
         RowBox[{"{",
          RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
        "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"SeriesWithNTerms", "[",
        RowBox[{"hdd", ",",
         RowBox[{"{",
          RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
        "]"}], ",",
       RowBox[{"SeriesWithNTerms", "[",
        RowBox[{"ad", ",",
         RowBox[{"{",
          RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
        "]"}], ",",
       RowBox[{"SeriesWithNTerms", "[",
        RowBox[{"var\[Phi]", ",",
         RowBox[{"{",
          RowBox[{"coordAsympt", ",", "LimitAsympt"}], "}"}], ",", "order"}],
        "]"}]}], "}"}], ",", "signatureg", ",",
     RowBox[{"{",
      RowBox[{"index1", ",", "index2"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"kin\[Phi]", ",", "kinA", ",", "\[Phi]Uneval"}], "}"}]}],
    "]"}]}], " ", ";"}]], "Input",
