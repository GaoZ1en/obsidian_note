Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Liediffd", "::", "usage"}], " ", "=", " ",
   "\"\<Liediffd[form_,coord_,xiU_] : Lie differential of forms \
\[IndentingNewLine]Input: the Lie vector field xiU, a one-form form and the \
list of coordinates coord \[IndentingNewLine]Output: the Lie derivative of \
form with respect to xiU\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.448813407109375*^9, 3.44881349065625*^9},
   3.448813618609375*^9,
   3.44921511190625*^9},ExpressionUUID->"62b03881-92e4-4d19-a4d4-\
8e3d71a4bb9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Liediffd", "[",
    RowBox[{"form_List", ",", "coord_List", ",", "xiU_List"}], "]"}], " ", ":=",
    " ",
   RowBox[{
    RowBox[{"Table", "[", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"Sum", "[",
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"D", "[",
           RowBox[{
            RowBox[{"form", "[",
             RowBox[{"[", "indmu", "]"}], "]"}], ",",
            RowBox[{"coord", "[",
             RowBox[{"[", "indrho", "]"}], "]"}]}], "]"}],
          RowBox[{"xiU", "[",
           RowBox[{"[", "indrho", "]"}], "]"}]}], "+",
         RowBox[{
          RowBox[{"D", "[",
           RowBox[{
            RowBox[{"xiU", "[",
             RowBox[{"[", "indrho", "]"}], "]"}], ",",
            RowBox[{"coord", "[",
             RowBox[{"[", "indmu", "]"}], "]"}]}], "]"}], " ",
          RowBox[{"form", "[",
           RowBox[{"[", "indrho", "]"}], "]"}]}]}], ",",
        RowBox[{"{",
         RowBox[{"indrho", ",",
          RowBox[{"Length", "[", "form", "]"}]}], "}"}]}], "]"}], ",",
      RowBox[{"{",
       RowBox[{"indmu", ",", " ",
        RowBox[{"Length", "[", "coord", "]"}]}], "}"}]}], "]"}], " ", "/;",
    " ",
    RowBox[{
     RowBox[{
      RowBox[{"Dimensions", "[", "form", "]"}], "\[Equal]", " ",
      RowBox[{"Dimensions", "[", "coord", "]"}]}], "&&",
     RowBox[{
      RowBox[{"Dimensions", "[", "xiU", "]"}], "\[Equal]", " ",
      RowBox[{"Dimensions", "[", "coord", "]"}]}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.444751792730921*^9, 3.444751805111199*^9}, {
   3.444751971894845*^9, 3.4447519813397207`*^9}, {3.444752045801941*^9,
