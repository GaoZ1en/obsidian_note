Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GenerateEpsilon", "::", "usage"}], " ", "=",
   "\"\<GenerateEpsilon[dim_] : Generate the totally antisymmetric \
numerically invariant pseudo-tensor Epsilon\nInput: dimension dim > 0\n\
Output: Epsilon\nConvention: Epsilon[[1,...,dim]] = +1\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449077651859375*^9, 3.449077661015625*^9}, {
  3.449077722109375*^9, 3.449077840984375*^9}, {3.449078001546875*^9,
  3.449078006890625*^9}, {3.4490781061875*^9,
  3.4490781629375*^9}},ExpressionUUID->"b802c75e-92c4-42a0-9e86-671ceca260e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GenerateEpsilon", "[", "dim_Integer", "]"}], " ", ":=", " ",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"String0", ",", "String1", ",", "perm00", ",", "k", ",", "i"}],
      "}"}], ",", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{"dim", "<", "1"}], ",", " ",
        RowBox[{
         RowBox[{"Return", "[", "\"\<Invalid arguments.\>\"", "]"}], ";"}]}],
       "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"Epsilon", "=."}], ";", "\[IndentingNewLine]",
      RowBox[{"Epsilon", " ", "=", " ",
       RowBox[{"ConstantArray", "[",
        RowBox[{"0", ",",
         RowBox[{"Table", "[",
          RowBox[{"dim", ",",
           RowBox[{"{",
            RowBox[{"k", ",", "1", ",", "dim"}], "}"}]}], "]"}]}], "]"}]}],
      ";", "\[IndentingNewLine]",
      RowBox[{"perm00", " ", "=", " ",
       RowBox[{"Permutations", "[",
        RowBox[{"Table", "[",
         RowBox[{"k", ",",
          RowBox[{"{",
           RowBox[{"k", ",", "1", ",", "dim"}], "}"}]}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"For", "[",
       RowBox[{
        RowBox[{"i", "=", "1"}], ",",
        RowBox[{"i", "\[LessEqual]",
         RowBox[{"Length", "[", "perm00", "]"}]}], ",",
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]",
        RowBox[{
         RowBox[{"String0", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]",
         RowBox[{"For", "[",
          RowBox[{
           RowBox[{"j", "=", "1"}], ",",
           RowBox[{"j", "<", "dim"}], ",",
           RowBox[{"j", "++"}], ",",
           RowBox[{"String0", " ", "=", " ",
            RowBox[{"String0", " ", "<>", " ",
             RowBox[{"ToString", "[",
              RowBox[{
               RowBox[{"perm00", "[",
                RowBox[{"[", "i", "]"}], "]"}], "[",
               RowBox[{"[", "j", "]"}], "]"}], "]"}], " ", "<>", " ",
             "\"\<,\>\""}]}]}], "  ", "]"}], ";", "\[IndentingNewLine]",
         RowBox[{"String0", " ", "=", " ",
          RowBox[{"String0", " ", "<>", " ",
           RowBox[{"ToString", "[",
            RowBox[{
             RowBox[{"perm00", " ", "[",
              RowBox[{"[", "i", "]"}], "]"}], "[",
             RowBox[{"[", "dim", "]"}], "]"}], "]"}]}]}], ";",
         "\[IndentingNewLine]",
         RowBox[{"String1", " ", "=", " ",
          RowBox[{
          "\"\<Epsilon[[\>\"", " ", "<>", " ", "String0", " ", "<>", " ",
           "\"\<]] = Signature[\>\"", " ", "<>", " ",
           RowBox[{"ToString", "[", "perm00", "]"}], " ", "<>", "\"\<[[\>\"",
           " ", "<>",
           RowBox[{"ToString", "[", "i", "]"}], " ", "<>", " ",
           "\"\<]]];\>\""}]}], ";", "\[IndentingNewLine]",
         RowBox[{"ToExpression", "[", "String1", "]"}], ";"}]}],
       "\[IndentingNewLine]", "]"}], ";", "Epsilon"}]}],
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.44571025669625*^9, 3.445710301975391*^9}, {
   3.445710361694895*^9, 3.445710379847405*^9}, {3.4457104518690233`*^9,
   3.445710620957876*^9}, {3.445710665141079*^9, 3.445710726087291*^9},
   3.4457108938691874`*^9, {3.4457110595787687`*^9, 3.445711099542941*^9}, {
   3.445711155331134*^9, 3.445711214957901*^9}, 3.445711300360948*^9, {
   3.445711388785688*^9, 3.44571140895061*^9}, {3.445711510216422*^9,
   3.445711530481039*^9}, {3.445711560789905*^9, 3.445711742953281*^9}, {
   3.445711822215815*^9, 3.445711829850041*^9}, 3.445711874679921*^9,
   3.445780145096127*^9, {3.445780237122423*^9, 3.4457802612896967`*^9}, {
   3.44578030501381*^9, 3.445780311838242*^9}, {3.445780348139915*^9,
   3.445780370674878*^9}, {3.4457804336999273`*^9, 3.445780449737864*^9},
   3.445780547946849*^9, {3.445780634820689*^9, 3.445780649936206*^9},
   3.4457806889360313`*^9, {3.445780773899247*^9, 3.445780793049079*^9}, {
   3.447425235839368*^9, 3.447425275066712*^9}, {3.449078009640625*^9,
   3.449078059984375*^9}, {3.450105009953125*^9,
   3.450105014015625*^9}},ExpressionUUID->"38552645-5cbe-4892-8f4f-\
40aacfce0d4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinstein", "::", "usage"}], " ", "=", " ",
   "\"\<ChargesEinstein[xiU_,hdd_,signatureg_,{index1_,index2_}] compute the \
surface charge in Einstein gravity\nNeed = metric and coord should be defined \
and RGtensors should have been executed prior to this procedure\nInput = A \
Killing vector or asymptotic Killing vector 'xiU' \n        A metric \
perturbation 'hdd'\n\t    The signature of the metric 'signatureg' (1 or -1)\n\
        A surface of codimension 2 specified by the two indices \
'{index1,index2}' in the coordinates coord that are fixed\nOutput = The \
components {index1,index2} of the surface charge associated with the vector \
xiU under the perturbation\nExtra output : ChargeSuppl : supplementary term \
with respect to the Iyer-Wald formula.\nConvention : The Einstein Lagrangian \
has the form 1/(16\[Pi])Sqrt[signatureg g] R\n\>\""}], ";"}]], "Input",
 CellChangeTimes->{{3.449078349953125*^9, 3.44907845025*^9}, {
  3.449078599375*^9, 3.449078648984375*^9}, {3.449078723953125*^9,
  3.44907884046875*^9}, {3.449079174421875*^9, 3.44907926540625*^9}, {
  3.449405217921875*^9, 3.449405298078125*^9}, {3.4494055233125*^9,
  3.4494055234375*^9}},ExpressionUUID->"8935eb1a-8661-4a26-9b60-a46afdeb77d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ChargesEinstein", "[",
    RowBox[{"xiU_List", ",", "hdd_List", ",", "signatureg_Integer", ",",
     RowBox[{"{",
      RowBox[{"index1_Integer", ",", "index2_Integer"}], "}"}]}], "]"}], " ",
   ":=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
      "hUd", ",", "hUU", ",", "deth", ",", "xid", ",", "xiUjd", ",", "xiUjU",
       ",", "xidjU", ",", "dethjd", ",", "dethjU", ",", "hUUjd", ",", "hUUjU",
        ",", "Integrand1UU", ",", "Integrand2UU", ",", "KillingUd", ",",
       "IntegrandEUU", ",", "Charge"}], "}"}], ",", "\[IndentingNewLine]",
     RowBox[{
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "gdd", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Raise\>\"", "]"}], " ", "&&", " ",
         RowBox[{"NameQ", "[", "\"\<Lower\>\"", "]"}], "&&",
         RowBox[{"NameQ", "[", "\"\<covD\>\"", " ", "]"}], "&&",
         RowBox[{"ValueQ", "[", "gUU", "]"}], " ", "&&",
         RowBox[{"ValueQ", "[", "detg", "]"}]}], "   ", ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<RGtensors should be executed prior to this procedure.\>\"",
          "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"ValueQ", "[", "coord", "]"}], " ", "&&", " ",
         RowBox[{"ValueQ", "[", "metric", "]"}]}], "   ", ",", ",", " ",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<metric and coord not defined.\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"signatureg", " ", "=!=", "  ", "1"}], " ", "&&", " ",
         RowBox[{"signatureg", " ", "=!=", "  ",
          RowBox[{"-", "1"}]}]}], " ", ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incoherent signature detected\>\"", "]"}], ";"}],
         ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<Signature of the metric: \>\"", ",", "signatureg", ",",
           "\"\< .\>\""}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "hdd", "]"}], " ", "=!=", "  ",
         RowBox[{"Dimensions", "[", "metric", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], " ", "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "coord", "]"}], " ", "=!=", " ",
         RowBox[{"Dimensions", "[", "xiU", "]"}]}], ",",
        RowBox[{
         RowBox[{
         "Return", "[", "\"\<Incompatible dimensions detected\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"If", "[",
       RowBox[{
        RowBox[{
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}], " ", "&&",
         RowBox[{"1", "\[LessEqual]", "index1", " ", "\[LessEqual]",
          RowBox[{
           RowBox[{"Dimensions", "[", "coord", "]"}], "[",
           RowBox[{"[", "1", "]"}], "]"}]}]}], ",", " ",
        RowBox[{
         RowBox[{"Print", "[",
          RowBox[{
          "\"\<The surface charge is inversely proportional to Newton \
constant and should be integrated on the \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index1", "]"}], "]"}], ",", "\"\< , \>\"", ",",
           RowBox[{"coord", "[",
            RowBox[{"[", "index2", "]"}], "]"}], ",",
           "\"\< = constant surface\>\""}], "]"}], ";"}],
        "\[IndentingNewLine]", ",",
        RowBox[{
         RowBox[{
         "Return", "[",
          "\"\<Invalid arguments for the choice of n-2 surface\>\"", "]"}],
         ";"}]}], "]"}], ";", "\[IndentingNewLine]",
      RowBox[{"hUd", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hdd", ",", "1"}], "]"}]}], ";",
      RowBox[{"hUU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hUd", ",", "2"}], "]"}]}], ";",
      RowBox[{"deth", " ", "=", " ",
       RowBox[{"multiDot", "[",
        RowBox[{"gUU", ",", "hdd", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"xid", " ", "=", " ",
       RowBox[{"Lower", "[",
        RowBox[{"xiU", ",", "1"}], "]"}]}], ";",
      RowBox[{"xiUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"xiU", ",",
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";",
      RowBox[{"xiUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"xiUjd", ",", "2"}], "]"}]}], ";",
      RowBox[{"xidjU", " ", "=", " ",
       RowBox[{"Lower", "[",
        RowBox[{"xiUjU", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"dethjd", " ", "=", " ",
       RowBox[{"covD", "[", "deth", "]"}]}], ";",
      RowBox[{"dethjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"dethjd", ",", "1"}], "]"}]}], ";",
      RowBox[{"hUUjd", " ", "=", " ",
       RowBox[{"covD", "[",
        RowBox[{"hUU", ",",
         RowBox[{"{",
          RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";",
      RowBox[{"hUUjU", " ", "=", " ",
       RowBox[{"Raise", "[",
        RowBox[{"hUUjd", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand1UU", " ", "=", " ",
       RowBox[{"Outer", "[",
        RowBox[{"Times", ",", "xiU", ",",
         RowBox[{
          RowBox[{"Contract", "[",
           RowBox[{"hUUjd", ",",
            RowBox[{"{",
             RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "-", "dethjU"}]}],
        "]"}]}], ";", "\[IndentingNewLine]",
      RowBox[{"Integrand2UU", " ", "=", " ",
       RowBox[{
        RowBox[{"-",
         RowBox[{"Transpose", "[",
          RowBox[{
           RowBox[{"multiDot", "[",
            RowBox[{"xid", ",", "hUUjU", ",",
             RowBox[{"{",
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ",",
           RowBox[{"{",
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "-",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "deth", " ",
         RowBox[{"Transpose", "[",
          RowBox[{"xiUjU", ",",
           RowBox[{"{",
            RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "+", " ",
        RowBox[{
         RowBox[{"1", "/", "2"}], " ",
         RowBox[{"multiDot", "[",
          RowBox[{"hUU", ",",
           RowBox[{"xiUjd", "-",
            RowBox[{"Transpose", "[",
             RowBox[{"xidjU", ",",
              RowBox[{"{",
               RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ",",
           RowBox[{"{",
            RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"KillingUd", " ", "=", " ",
       RowBox[{"xiUjd", "+",
        RowBox[{"Transpose", "[",
         RowBox[{"xidjU", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"IntegrandEUU", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], " ",
        RowBox[{"multiDot", "[",
         RowBox[{"hUU", ",", "KillingUd", ",",
          RowBox[{"{",
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]",
      RowBox[{"ChargeSuppl", " ", "=", "  ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ", " ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"IntegrandEUU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"IntegrandEUU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]",
      RowBox[{"Charge", " ", "=", " ",
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "16"}], "/", "Pi"}], "  ",
        RowBox[{"Sqrt", "[",
         RowBox[{"signatureg", " ", "detg"}], "]"}], " ", " ",
        RowBox[{"(",
         RowBox[{
          RowBox[{"Integrand1UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand1UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}], "+",
          RowBox[{"Integrand2UU", "[",
           RowBox[{"[",
            RowBox[{"index1", ",", "index2"}], "]"}], "]"}], "-",
          RowBox[{"Integrand2UU", "[",
           RowBox[{"[",
            RowBox[{"index2", ",", "index1"}], "]"}], "]"}]}], ")"}]}]}]}]}],
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.43897310171875*^9, 3.43897329153125*^9}, {
